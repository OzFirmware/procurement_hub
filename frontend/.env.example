# Copy to .env.local (gitignored) for local development.
# CI builds get these from GitHub Actions secrets instead — see SETUP.md.

# Apps Script web app URL (Deploy → Web app → /exec URL)
VITE_APP_URL=https://script.google.com/macros/s/XXXXXXXX/exec

# Google OAuth client ID (Google Cloud console → Credentials)
VITE_CLIENT_ID=000000000000-xxxxxxxxxxxxxxxx.apps.googleusercontent.com
