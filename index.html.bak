<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>OIZOM Procurement Tracker</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;600;700&family=Inter:wght@400;500;600&family=IBM+Plex+Mono:wght@400;500;600&display=swap" rel="stylesheet">
<style>
:root{
  --bg:#F4F7F5; --panel:#FFFFFF; --ink:#14241C; --mut:#5E7066; --line:#DEE7E1;
  --brand:#0E7B5B; --brand-soft:#E2F2EB; --dark:#0F1F18; --dark2:#16291F;
  --amber:#B25E09; --amber-soft:#FBEEDC; --red:#B3362B; --red-soft:#FAE6E3;
  --blue:#2A5FAA; --blue-soft:#E4ECF8; --grey-soft:#ECF0ED;
  --mono:'IBM Plex Mono',monospace; --disp:'Space Grotesk',sans-serif; --body:'Inter',sans-serif;
}
*{box-sizing:border-box;margin:0;padding:0}
/* auth gate */
.auth-gate{position:fixed;inset:0;z-index:9999;background:linear-gradient(160deg,#0F1F18,#16291F);display:flex;flex-direction:column;align-items:center;justify-content:center;gap:18px;padding:24px}
.auth-gate.hidden{display:none}
.auth-box{background:#fff;border-radius:16px;padding:30px 28px;width:min(380px,100%);box-shadow:0 20px 60px rgba(0,0,0,.35)}
.auth-logo{font-family:'Space Grotesk',sans-serif;font-weight:700;font-size:22px;text-align:center;color:#0F1F18;margin-bottom:6px}
.auth-logo b{color:#0E7B5B}
.auth-box h2{font-family:'Space Grotesk',sans-serif;font-size:17px;font-weight:600;text-align:center;margin:14px 0 4px;color:#14241C}
.auth-box p.sub{font-size:12.5px;color:#5E7066;text-align:center;margin-bottom:18px;line-height:1.5}
.auth-box label{display:block;font-size:11px;color:#5E7066;font-weight:500;margin:12px 0 4px}
.auth-box input{width:100%;border:1px solid #DEE7E1;border-radius:9px;padding:10px 12px;font-size:14px;font-family:inherit;color:#14241C}
.auth-box input:focus{outline:2px solid #0E7B5B;outline-offset:1px;border-color:#0E7B5B}
.auth-btn{width:100%;margin-top:18px;background:#0E7B5B;color:#fff;border:none;border-radius:9px;padding:11px;font-size:14px;font-weight:600;cursor:pointer}
.auth-btn:hover{filter:brightness(1.08)}
.auth-err{background:#FAE6E3;color:#B3362B;border-radius:8px;padding:9px 12px;font-size:12.5px;margin-top:14px;display:none}
.auth-err.show{display:block}
.auth-ok{background:#E2F2EB;color:#0E7B5B;border-radius:8px;padding:11px 12px;font-size:12px;margin-top:14px;line-height:1.5;word-break:break-all}
.auth-ok code{display:block;background:#0F1F18;color:#5BD6A8;font-family:'IBM Plex Mono',monospace;font-size:11px;padding:8px 10px;border-radius:6px;margin-top:8px;user-select:all}
.auth-note{color:#6E8C7B;font-size:11.5px;letter-spacing:.04em}
.auth-link{display:block;text-align:center;margin-top:14px;font-size:12px;color:#0E7B5B;background:none;border:none;width:100%;cursor:pointer;text-decoration:underline}
html,body{background:var(--bg);color:var(--ink);font-family:var(--body);font-size:13.5px}
button{font-family:inherit;cursor:pointer}
a{color:var(--brand)}
:focus-visible{outline:2px solid var(--brand);outline-offset:2px}

/* ===== header ===== */
header{background:var(--dark);color:#E8F1EB;padding:18px 24px 0}
.hd-top{display:flex;align-items:baseline;gap:14px;flex-wrap:wrap}
.logo{font-family:var(--disp);font-weight:700;font-size:21px;letter-spacing:.5px;color:#fff}
.logo b{color:#5BD6A8}
.hd-sub{font-size:12px;color:#9DB5A8;letter-spacing:.04em}
.hd-actions{margin-left:auto;display:flex;gap:8px}
.hd-actions button{background:#233A2E;color:#D7E8DD;border:1px solid #335444;border-radius:7px;padding:7px 13px;font-size:12.5px;font-weight:500}
.hd-actions button.primary{background:var(--brand);border-color:var(--brand);color:#fff}
.sync-chip{align-self:center;font-family:var(--mono);font-size:11px;color:#8FAE9C;border:1px dashed #335444;border-radius:20px;padding:5px 11px;white-space:nowrap}
.user-chip{align-self:center;font-size:11.5px;color:#D7E8DD;background:#233A2E;border:1px solid #335444;border-radius:20px;padding:5px 11px;white-space:nowrap}
.user-chip b{color:#5BD6A8;font-weight:600}
.sync-chip.live{color:#5BD6A8;border-style:solid;border-color:#2E5C45}
.sync-chip.err{color:#F08A7E;border-color:#6B3A33}
.hd-actions button:hover{filter:brightness(1.12)}
.kpis{display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:10px;padding:16px 0 18px}
.kpi{background:var(--dark2);border:1px solid #25402F;border-radius:10px;padding:12px 14px;cursor:pointer;transition:border-color .15s}
.kpi:hover{border-color:#4C7A5E}
.kpi.active{border-color:#5BD6A8;background:#1B3326}
.kpi .n{font-family:var(--disp);font-size:24px;font-weight:700;color:#fff;line-height:1.1}
.kpi .l{font-size:11px;color:#8FAE9C;margin-top:3px;letter-spacing:.05em;text-transform:uppercase}
.kpi .s{font-size:11px;color:#6E8C7B;margin-top:2px;font-family:var(--mono)}
.kpi.warn .n{color:#F1B266}
.kpi.bad .n{color:#F08A7E}
.kpi.go .n{color:#5BD6A8}

/* ===== filter bar ===== */
.bar{position:sticky;top:0;z-index:30;background:var(--bg);border-bottom:1px solid var(--line);padding:10px 24px;display:flex;gap:8px;flex-wrap:wrap;align-items:center}
.bar select,.bar input[type=search]{border:1px solid var(--line);background:var(--panel);border-radius:7px;padding:7px 9px;font-size:12.5px;color:var(--ink);font-family:inherit}
.bar input[type=search]{flex:1;min-width:180px}
.bar .clr{background:none;border:none;color:var(--mut);font-size:12px;text-decoration:underline}
.count{font-family:var(--mono);font-size:12px;color:var(--mut);margin-left:auto;white-space:nowrap}
.daterange{display:inline-flex;align-items:center;gap:5px}
.daterange label{font-size:11px;color:var(--mut)}
.daterange input[type=date]{border:1px solid var(--line);background:var(--panel);border-radius:7px;padding:6px 8px;font-size:12px;color:var(--ink);font-family:inherit}

/* view tabs */
.viewtabs{display:flex;gap:6px;padding:12px 24px 0}
.vtab{background:var(--panel);border:1px solid var(--line);border-bottom:none;border-radius:9px 9px 0 0;padding:9px 16px;font-size:13px;font-weight:600;color:var(--mut)}
.vtab.active{color:var(--brand);background:var(--panel);box-shadow:inset 0 -2px 0 var(--brand)}
.vtab:hover{color:var(--ink)}

/* dashboard */
.dashgrid{display:grid;grid-template-columns:1.9fr 1fr;gap:14px}
.card{background:var(--panel);border:1px solid var(--line);border-radius:12px;padding:16px 18px}
.cardhead{display:flex;align-items:center;gap:12px;margin-bottom:12px}
.cardhead h3{font-family:var(--disp);font-size:15px;font-weight:600}
.metricsel{margin-left:auto;display:flex;gap:4px;background:var(--grey-soft);border-radius:8px;padding:3px}
.mbtn{border:none;background:none;border-radius:6px;padding:5px 11px;font-size:12px;font-weight:600;color:var(--mut)}
.mbtn.active{background:#fff;color:var(--brand);box-shadow:0 1px 2px rgba(0,0,0,.08)}
.curwrap{display:flex;align-items:center;gap:7px;margin-bottom:8px}
.curwrap label{font-size:11px;color:var(--mut)}
.curwrap select{border:1px solid var(--line);border-radius:7px;padding:5px 8px;font-size:12px;font-family:inherit}
.charthint{font-size:11px;color:var(--mut);margin-top:6px;text-align:center}
#chart{overflow-x:auto}
.bar-rect{cursor:pointer;transition:opacity .12s}
.bar-rect:hover{opacity:.78}
.bar-val{font-family:var(--mono);font-size:10px;fill:var(--ink)}
.bar-lbl{font-size:10px;fill:var(--mut)}
.gridline{stroke:#EDF2EE;stroke-width:1}
.axis-lbl{font-size:9px;fill:var(--mut);font-family:var(--mono)}

/* summary card */
.sumrow{display:flex;justify-content:space-between;align-items:baseline;padding:9px 0;border-bottom:1px solid #EDF2EE;font-size:13px}
.sumrow:last-child{border-bottom:none}
.sumrow .lab{color:var(--mut)}
.sumrow .val{font-family:var(--disp);font-weight:600;font-size:15px}
.sumrow .val.mono{font-family:var(--mono);font-size:13px}
.peak{background:var(--brand-soft);border-radius:8px;padding:11px 13px;margin-top:6px}
.peak .pk-l{font-size:11px;color:var(--brand);text-transform:uppercase;letter-spacing:.05em}
.peak .pk-v{font-family:var(--disp);font-size:16px;font-weight:600;margin-top:2px}

/* monthly table */
.mtablewrap{overflow-x:auto}
.mtable{width:100%;border-collapse:collapse;min-width:560px}
.mtable th{font-size:10.5px;text-transform:uppercase;letter-spacing:.06em;color:var(--mut);text-align:right;padding:8px 10px;border-bottom:1px solid var(--line);white-space:nowrap}
.mtable th:first-child{text-align:left}
.mtable td{padding:9px 10px;border-bottom:1px solid #EDF2EE;text-align:right;font-family:var(--mono);font-size:12px;white-space:nowrap}
.mtable td:first-child{text-align:left;font-family:var(--body);font-weight:600}
.mtable tr{cursor:pointer}
.mtable tbody tr:hover{background:#F4FAF6}
.mtable tfoot td{font-weight:700;border-top:2px solid var(--line);border-bottom:none;color:var(--ink)}
.minibar{height:6px;background:var(--brand-soft);border-radius:3px;display:inline-block;vertical-align:middle;margin-left:6px}
.ctxbanner{display:flex;align-items:center;gap:12px;background:var(--brand-soft);border:1px solid #BFE0D2;border-radius:10px;padding:10px 14px;margin-bottom:12px;font-size:13px}
.ctxbanner b{font-family:var(--disp);color:var(--brand)}
.ctxbanner .meta{color:var(--mut);font-family:var(--mono);font-size:12px}
.ctxbanner .acts{margin-left:auto;display:flex;gap:8px}
.ctxbanner button{border:1px solid #BFE0D2;background:#fff;border-radius:7px;padding:6px 11px;font-size:12px;font-weight:600;color:var(--brand)}
.ctxbanner button:hover{background:#fff;filter:brightness(.98)}
.mini-btn{border:1px solid var(--line);background:#fff;border-radius:7px;padding:6px 11px;font-size:12px;font-weight:600;color:var(--ink)}
.mini-btn:hover{border-color:var(--brand);color:var(--brand)}
.md-meta{font-family:var(--mono);font-size:12px;color:var(--mut);margin:-4px 0 12px}
.md-table{width:100%;border-collapse:collapse;min-width:680px}
.md-table th{font-size:10.5px;text-transform:uppercase;letter-spacing:.06em;color:var(--mut);text-align:left;padding:8px 10px;border-bottom:1px solid var(--line);white-space:nowrap}
.md-table td{padding:9px 10px;border-bottom:1px solid #EDF2EE;vertical-align:top}
.md-table tbody tr{cursor:pointer}
.md-table tbody tr:hover{background:#F4FAF6}
.md-table .amt{text-align:right;font-family:var(--mono);font-size:12.5px;white-space:nowrap}
/* vendor view */
.vbar{display:flex;gap:8px;flex-wrap:wrap;align-items:center;margin-bottom:14px}
.vbar input[type=search],.vbar select{border:1px solid var(--line);background:var(--panel);border-radius:8px;padding:8px 10px;font-size:12.5px;font-family:inherit;color:var(--ink)}
.vbar input[type=search]{flex:1;min-width:200px}
.vchk{display:flex;align-items:center;gap:5px;font-size:12.5px;color:var(--mut)}
.hd-actions-mini{background:var(--brand);color:#fff;border:1px solid var(--brand);border-radius:8px;padding:8px 14px;font-size:12.5px;font-weight:600}
.hd-actions-mini:hover{filter:brightness(1.08)}
.vgrid{display:grid;grid-template-columns:repeat(auto-fill,minmax(290px,1fr));gap:12px}
.vcard{background:var(--panel);border:1px solid var(--line);border-radius:12px;padding:15px 16px;cursor:pointer;transition:border-color .15s,box-shadow .15s}
.vcard:hover{border-color:var(--brand);box-shadow:0 4px 14px rgba(14,123,91,.08)}
.vcard .vhead{display:flex;align-items:flex-start;gap:8px;margin-bottom:10px}
.vcard h4{font-family:var(--disp);font-size:14.5px;font-weight:600;line-height:1.3;flex:1}
.vtype{font-size:10px;font-weight:600;border-radius:5px;padding:2px 6px;white-space:nowrap}
.vtype.Domestic{background:var(--brand-soft);color:var(--brand)}
.vtype.Foreign{background:var(--blue-soft);color:var(--blue)}
.vtype.Mixed{background:var(--amber-soft);color:var(--amber)}
.vtype.Unknown{background:var(--grey-soft);color:var(--mut)}
.vstats{display:grid;grid-template-columns:1fr 1fr;gap:8px 10px;font-size:12px}
.vstat .n{font-family:var(--disp);font-size:17px;font-weight:600}
.vstat .l{font-size:10px;color:var(--mut);text-transform:uppercase;letter-spacing:.04em}
.vstat .n.red{color:var(--red)}
.vmeta{margin-top:11px;padding-top:10px;border-top:1px solid #EDF2EE;font-size:11.5px;color:var(--mut);display:flex;flex-wrap:wrap;gap:4px 10px}
.vmeta .tag{background:var(--grey-soft);border-radius:5px;padding:2px 7px;color:var(--ink)}
.vbankdot{display:inline-block;width:7px;height:7px;border-radius:50%;background:var(--brand);margin-right:4px}
.vedited{background:var(--amber-soft);color:var(--amber);font-size:9px;border-radius:4px;padding:1px 5px;font-weight:600}
.vnewt{background:var(--blue-soft);color:var(--blue);font-size:9px;border-radius:4px;padding:1px 5px;font-weight:600}
/* vendor profile in drawer */
.vp-spend{display:flex;gap:14px;flex-wrap:wrap;margin-bottom:4px}
.vp-spend .s{background:var(--grey-soft);border-radius:8px;padding:8px 12px}
.vp-spend .s .v{font-family:var(--mono);font-size:14px;font-weight:600}
.vp-spend .s .l{font-size:10px;color:var(--mut)}
.vp-prlist{margin-top:4px}
.vp-pr{display:flex;align-items:center;gap:10px;padding:8px 0;border-bottom:1px solid #EDF2EE;cursor:pointer;font-size:12.5px}
.vp-pr:hover{background:#F4FAF6}
.vp-pr .pid{font-family:var(--mono);font-size:11px;color:var(--mut);width:62px;flex:none}
.vp-pr .pd{flex:1;font-weight:500}
.vp-pr .pa{font-family:var(--mono);font-size:12px;white-space:nowrap}

@media(max-width:760px){
  .dashgrid{grid-template-columns:1fr}
  .daterange{flex-wrap:wrap}
}

/* ===== table ===== */
main{padding:14px 24px 60px}
.tablewrap{background:var(--panel);border:1px solid var(--line);border-radius:12px;overflow:auto}
table{width:100%;border-collapse:collapse;min-width:1080px}
th{font-size:10.5px;text-transform:uppercase;letter-spacing:.07em;color:var(--mut);text-align:left;padding:10px 10px;border-bottom:1px solid var(--line);background:#FAFCFA;position:sticky;top:0;cursor:pointer;user-select:none;white-space:nowrap}
th:hover{color:var(--ink)}
th .arr{font-size:9px;margin-left:3px}
td{padding:9px 10px;border-bottom:1px solid #EDF2EE;vertical-align:top}
tbody tr{cursor:pointer}
tbody tr:hover{background:#F4FAF6}
.prid{font-family:var(--mono);font-size:11.5px;color:var(--mut);white-space:nowrap}
.desc{font-weight:600;max-width:260px}
.desc .v{font-weight:400;color:var(--mut);font-size:12px;margin-top:2px}
.amt{font-family:var(--mono);font-size:12.5px;white-space:nowrap;text-align:right}
.curcode{font-size:9.5px;color:var(--mut);letter-spacing:.04em;margin-top:1px}
.dt{font-family:var(--mono);font-size:11.5px;color:var(--mut);white-space:nowrap}

/* pipeline */
.pipe{display:flex;align-items:center;gap:0;min-width:118px}
.pipe .d{width:11px;height:11px;border-radius:50%;border:2px solid #C6D4CB;background:#fff;flex:none}
.pipe .c{height:2px;width:18px;background:#C6D4CB;flex:none}
.pipe .d.on{background:var(--brand);border-color:var(--brand)}
.pipe .c.on{background:var(--brand)}
.pipe.cancel .d,.pipe.cancel .d.on{background:#E5B5B0;border-color:#E5B5B0}
.pipe.cancel .c,.pipe.cancel .c.on{background:#E5B5B0}
.pipelbl{font-size:10px;color:var(--mut);margin-top:3px;letter-spacing:.03em}

/* badges */
.b{display:inline-block;padding:3px 8px;border-radius:20px;font-size:11px;font-weight:600;white-space:nowrap}
.b.paid{background:var(--brand-soft);color:var(--brand)}
.b.unpaid{background:var(--red-soft);color:var(--red)}
.b.part{background:var(--amber-soft);color:var(--amber)}
.b.foc{background:var(--blue-soft);color:var(--blue)}
.b.rcv{background:var(--brand-soft);color:var(--brand)}
.b.transit{background:var(--blue-soft);color:var(--blue)}
.b.proc{background:var(--amber-soft);color:var(--amber)}
.b.cancel{background:var(--grey-soft);color:var(--mut);text-decoration:line-through}
.b.hold{background:var(--red-soft);color:var(--red)}
.b.hi{background:var(--red-soft);color:var(--red)}
.b.med{background:var(--amber-soft);color:var(--amber)}
.b.lo{background:var(--grey-soft);color:var(--mut)}
.b.none{background:var(--grey-soft);color:var(--mut)}

.empty{padding:50px;text-align:center;color:var(--mut)}
.empty b{display:block;font-family:var(--disp);font-size:16px;color:var(--ink);margin-bottom:6px}

/* ===== drawer ===== */
.overlay{position:fixed;inset:0;background:rgba(15,31,24,.45);z-index:40;opacity:0;pointer-events:none;transition:opacity .2s}
.overlay.open{opacity:1;pointer-events:auto}
.drawer{position:fixed;top:0;right:-560px;width:min(560px,100vw);height:100vh;background:var(--panel);z-index:50;box-shadow:-12px 0 40px rgba(15,31,24,.18);transition:right .25s ease;display:flex;flex-direction:column}
.drawer.open{right:0}
.dr-head{padding:18px 22px 14px;border-bottom:1px solid var(--line);display:flex;align-items:flex-start;gap:10px}
.dr-head h2{font-family:var(--disp);font-size:17px;font-weight:600;line-height:1.3}
.dr-head .prid{display:block;margin-bottom:4px}
.dr-close{margin-left:auto;background:none;border:1px solid var(--line);border-radius:7px;width:30px;height:30px;font-size:15px;color:var(--mut);flex:none}
.dr-body{overflow-y:auto;padding:18px 22px 30px;flex:1}
.dr-sec{margin-bottom:20px}
.dr-sec h3{font-size:10.5px;text-transform:uppercase;letter-spacing:.08em;color:var(--mut);margin-bottom:9px;font-weight:600}
.kv{display:grid;grid-template-columns:130px 1fr;gap:6px 12px;font-size:12.5px}
.kv .k{color:var(--mut)}
.kv .v{word-break:break-word}
.kv .v.mono{font-family:var(--mono);font-size:12px}
.dr-edit{display:grid;grid-template-columns:1fr 1fr;gap:10px}
.dr-edit label{display:block;font-size:11px;color:var(--mut);margin-bottom:4px;font-weight:500}
.dr-edit select,.dr-edit input{width:100%;border:1px solid var(--line);border-radius:7px;padding:8px;font-size:12.5px;font-family:inherit;background:#fff}
.dr-edit .full{grid-column:1/-1}
.dr-edit textarea{width:100%;border:1px solid var(--line);border-radius:7px;padding:8px;font-size:12.5px;font-family:inherit;min-height:56px;resize:vertical}
.dr-foot{padding:14px 22px;border-top:1px solid var(--line);display:flex;gap:8px}
.btn{border-radius:8px;padding:9px 16px;font-size:13px;font-weight:600;border:1px solid var(--line);background:#fff;color:var(--ink)}
.btn.primary{background:var(--brand);border-color:var(--brand);color:#fff}
.btn.primary:hover{filter:brightness(1.08)}
.bigpipe{display:flex;gap:0;align-items:center;margin:4px 0 2px}
.bigpipe .st{display:flex;flex-direction:column;align-items:center;gap:5px;width:86px}
.bigpipe .st .d{width:16px;height:16px;border-radius:50%;border:3px solid #C6D4CB;background:#fff}
.bigpipe .st .d.on{background:var(--brand);border-color:var(--brand)}
.bigpipe .st span{font-size:10px;color:var(--mut);letter-spacing:.03em;text-align:center}
.bigpipe .cc{height:3px;flex:1;background:#C6D4CB;margin-bottom:18px;min-width:14px}
.bigpipe .cc.on{background:var(--brand)}
.saved{font-size:12px;color:var(--brand);align-self:center;opacity:0;transition:opacity .3s}
.saved.show{opacity:1}

/* modal (new PR) reuses drawer */
.tagnew{background:var(--blue-soft);color:var(--blue);font-size:10px;border-radius:4px;padding:2px 5px;font-weight:600;margin-left:6px;vertical-align:1px}
.tagedit{background:var(--amber-soft);color:var(--amber);font-size:10px;border-radius:4px;padding:2px 5px;font-weight:600;margin-left:6px;vertical-align:1px}

@media(max-width:760px){
  header{padding:14px 14px 0}.bar{padding:8px 14px}main{padding:10px 10px 50px}
  .kv{grid-template-columns:110px 1fr}.dr-edit{grid-template-columns:1fr}
}
</style>
</head>
<body>

<div id="authGate" class="auth-gate">
  <div class="auth-box">
    <div class="auth-logo">OIZOM<b>·</b>Procurement</div>
    <div id="authBody"></div>
  </div>
  <div class="auth-note">Internal procurement tool · authorized users only</div>
</div>

<header>
  <div class="hd-top">
    <div class="logo">OIZOM<b>·</b>Procurement</div>
    <div class="hd-sub">Purchase request tracker · Payment &amp; dispatch · F-PUR-04</div>
    <div class="hd-actions">
      <span id="syncChip" class="sync-chip">Snapshot data</span>
      <button id="btnConnect">⚙ Connect sheet</button>
      <button id="btnSync" style="display:none">↻ Sync</button>
      <button id="btnExport">Export CSV</button>
      <span id="userChip" class="user-chip" style="display:none"></span>
      <button id="btnLock" style="display:none">Log out</button>
      <button id="btnNew" class="primary">+ New PR</button>
    </div>
  </div>
  <div class="kpis" id="kpis"></div>
</header>

<div class="bar">
  <input type="search" id="q" placeholder="Search description, vendor, PO no, tracking no, requester…">
  <select id="fDept"><option value="">All departments</option></select>
  <select id="fPay"><option value="">Payment: all</option></select>
  <select id="fMat"><option value="">Dispatch: all</option></select>
  <select id="fPrio"><option value="">Priority: all</option></select>
  <select id="fType"><option value="">Material type: all</option></select>
  <select id="fCur"><option value="">Currency: all</option></select>
  <select id="fVendor"><option value="">Vendor: all</option></select>
  <span class="daterange">
    <label>From</label><input type="date" id="dFrom">
    <label>To</label><input type="date" id="dTo">
    <select id="dQuick" title="Quick ranges">
      <option value="">Date: all time</option>
      <option value="thismonth">This month</option>
      <option value="lastmonth">Last month</option>
      <option value="last3">Last 3 months</option>
      <option value="last6">Last 6 months</option>
      <option value="thisyear">This year</option>
    </select>
  </span>
  <button class="clr" id="btnClr">Clear</button>
  <span class="count" id="count"></span>
</div>

<div class="viewtabs">
  <button class="vtab active" data-v="table">☰ Requests</button>
  <button class="vtab" data-v="dash">📊 Monthly dashboard</button>
  <button class="vtab" data-v="vendor">🏢 Vendors</button>
</div>

<main>
  <section id="dashView" style="display:none">
    <div class="dashgrid">
      <div class="card chartcard">
        <div class="cardhead">
          <h3 id="dashTitle">Monthly trend</h3>
          <div class="metricsel">
            <button class="mbtn active" data-m="count">PR count</button>
            <button class="mbtn" data-m="spend">Spend</button>
            <button class="mbtn" data-m="unpaid">Unpaid</button>
          </div>
        </div>
        <div id="dashCurWrap" class="curwrap" style="display:none">
          <label>Currency</label><select id="dashCur"></select>
        </div>
        <div id="chart"></div>
        <div class="charthint">Click a bar to filter everything to that month.</div>
      </div>
      <div class="card" id="dashSummary"></div>
    </div>
    <div class="card" style="margin-top:14px">
      <div class="cardhead"><h3>Month-by-month totals</h3></div>
      <div class="mtablewrap"><table class="mtable" id="mtable"></table></div>
    </div>
    <div class="card" id="monthDetail" style="display:none;margin-top:14px"></div>
  </section>

  <section id="tableView">
    <div id="ctxBanner" class="ctxbanner" style="display:none"></div>
    <div class="tablewrap">
      <table>
        <thead><tr id="thead"></tr></thead>
        <tbody id="tbody"></tbody>
      </table>
      <div class="empty" id="empty" style="display:none"><b>No purchase requests match</b>Try clearing a filter or changing the search.</div>
    </div>
  </section>

  <section id="vendorView" style="display:none">
    <div class="vbar">
      <input type="search" id="vq" placeholder="Search vendor name…">
      <select id="vType"><option value="">Type: all</option><option>Domestic</option><option>Foreign</option><option>Mixed</option></select>
      <select id="vSort">
        <option value="prCount">Sort: most PRs</option>
        <option value="spend">Sort: highest spend</option>
        <option value="unpaid">Sort: most unpaid</option>
        <option value="name">Sort: name (A–Z)</option>
      </select>
      <label class="vchk"><input type="checkbox" id="vBank"> Has bank details</label>
      <button class="hd-actions-mini" id="btnAddVendor">+ Add vendor</button>
      <span class="count" id="vcount"></span>
    </div>
    <div class="vgrid" id="vgrid"></div>
    <div class="empty" id="vempty" style="display:none"><b>No vendors match</b>Try a different search or filter.</div>
  </section>
</main>

<div class="overlay" id="overlay"></div>
<aside class="drawer" id="drawer" aria-label="Purchase request detail"></aside>

