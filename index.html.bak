/* ---------- live sheet sync ---------- */
const DEPTS=['Support','Production','R&D','QC','Device Management','Environment','Marketing','Admin','Sales','Projects'];
let CFG={appUrl:'',sheetId:''}, LIVE=null, LAST_SYNC=null, SYNC_ERR='';
let AUTO_REFRESH=false, AUTO_TIMER=null;
function setAutoRefresh(on){
  AUTO_REFRESH=on; CFG.auto=on?1:0;
  if(AUTO_TIMER){clearInterval(AUTO_TIMER);AUTO_TIMER=null;}
  if(on&&(CFG.appUrl||CFG.sheetId))AUTO_TIMER=setInterval(()=>{if(AUTHED)syncNow();},60000);
}
function canonH(h){return String(h||'').replace(/\n/g,' ').replace(/[.:]/g,'').replace(/\s+/g,' ').trim().toLowerCase();}
const FIELD_MAP={ts:['timestamp'],reqBy:['requested by'],appBy:['approved by'],
 proj:['project details','purpose of purchase'],part:['zoho part number'],desc:['product description'],
 matType:['types of material'],vendor:['vendor name'],link:['purchase link'],qty:['quantity'],
 cur:['currency'],amt:['amount'],prio:['priority'],pay:['payment status'],payTerm:['payment term'],
 dueDate:['due date'],poNo:['po no'],poDate:['po date'],
 invNo:['invoice / order no','quote no / pi no invoice no / order no /','invoice no'],
 invDate:['invoice / order date'],courier:['ff / courier'],trackNo:['tracking number'],
 trackLink:['tracking link'],mat:['material status'],rcvDate:['mat rcv date'],
 remarks:['remarks'],comment:['comment']};
function jsNormPay(s){if(!s)return null;const t=s.toLowerCase();
 if(t.includes('unpaid'))return'Unpaid';if(t.includes('50')||t.includes('partial'))return'Partially Paid';
 if(t.includes('foc')||t.includes('free'))return'FOC / Free';if(t.includes('paid'))return'Paid';return s;}
function jsNormMat(s){if(!s)return null;const t=s.toLowerCase();
 if(t.includes('receiv'))return'Received';if(t.includes('transit'))return'In Transit';
 if(t.includes('process'))return'In Process';if(t.includes('cancel'))return'Cancelled';
 if(t.includes('hold'))return'On HOLD';return s;}
function jsNormDate(s){if(!s)return null;s=String(s).trim();if(!s)return null;
 let m=s.match(/^(\d{4})-(\d{2})-(\d{2})/);if(m)return m[1]+'-'+m[2]+'-'+m[3];
 m=s.match(/^(\d{1,2})[-/.](\d{1,2})[-/.](\d{2,4})/);
 if(m){let y=m[3].length===2?'20'+m[3]:m[3];return y+'-'+m[2].padStart(2,'0')+'-'+m[1].padStart(2,'0');}
 const d=new Date(s);if(!isNaN(d))return d.toISOString().slice(0,10);return s.slice(0,40);}
function okeyOf(r){return r.dept+'|'+(r.ts||'')+'|'+String(r.desc||'').slice(0,40);}
function buildRecords(sheets){ // sheets: {name:{headers:[],rows:[{row,cells}]}}
  const recs=[],seen={};let i=0;
  DEPTS.forEach(d=>{
    const sd=sheets[d]; if(!sd||!sd.headers)return;
    const H=sd.headers.map(canonH);
    const col={}; Object.keys(FIELD_MAP).forEach(f=>{
      for(const cand of FIELD_MAP[f]){const ix=H.indexOf(cand);if(ix>-1){col[f]=ix;break;}}});
    sd.rows.forEach(rw=>{
      const c=rw.cells, g=f=>{const ix=col[f];if(ix==null)return null;
        let v=c[ix];if(v==null)return null;v=String(v).trim();
        return (v===''||v==='nan'||v==='-')?null:v;};
      const desc=g('desc'),vendor=g('vendor'); if(!desc&&!vendor)return;
      i++;
      const ap=parseAmtStr(g('amt'));
      const cd=detectCur(g('cur'),g('amt'));
      const r={id:'PR-'+String(i).padStart(4,'0'),dept:d,ts:jsNormDate(g('ts')),
        reqBy:g('reqBy'),appBy:g('appBy'),proj:g('proj'),part:g('part'),desc:desc,
        matType:g('matType'),vendor:vendor,link:g('link'),qty:g('qty'),
        cur:cd.cur,curAuto:cd.auto?1:undefined,curGuess:cd.guess?1:undefined,amt:ap.amt,amtNote:ap.note,prio:g('prio'),pay:jsNormPay(g('pay')),payTerm:g('payTerm'),
        dueDate:jsNormDate(g('dueDate')),poNo:g('poNo'),poDate:jsNormDate(g('poDate')),
        invNo:g('invNo'),invDate:jsNormDate(g('invDate')),courier:g('courier'),
        trackNo:g('trackNo'),trackLink:g('trackLink'),mat:jsNormMat(g('mat')),
        rcvDate:jsNormDate(g('rcvDate')),remarks:g('remarks'),comment:g('comment'),
        _sheet:d,_row:rw.row};
      Object.keys(r).forEach(k=>{if(r[k]==null)delete r[k];});
      let ok=okeyOf(r); if(seen[ok]){seen[ok]++;ok+='#'+seen[ok];}else seen[ok]=1;
      r.okey=ok; recs.push(r);
    });
  });
  return recs;
}
function parseCSV(text){
  const rows=[],n=text.length;let row=[],cell='',q=false;
  for(let i=0;i<n;i++){const ch=text[i];
    if(q){if(ch==='"'){if(text[i+1]==='"'){cell+='"';i++;}else q=false;}else cell+=ch;}
    else if(ch==='"')q=true;
    else if(ch===','){row.push(cell);cell='';}
    else if(ch==='\n'||ch==='\r'){if(ch==='\r'&&text[i+1]==='\n')i++;row.push(cell);cell='';rows.push(row);row=[];}
    else cell+=ch;}
  if(cell!==''||row.length){row.push(cell);rows.push(row);}
  return rows;
}
async function syncNow(){
  setChip('Syncing…','');
  const bust='_cb='+Date.now()+Math.floor(Math.random()*1000);
  try{
    let sheets={};
    if(CFG.appUrl){
      const u=CFG.appUrl+(CFG.appUrl.includes('?')?'&':'?')+bust;
      const res=await fetch(u,{method:'GET',cache:'no-store',redirect:'follow'});
      if(!res.ok)throw new Error('HTTP '+res.status+' from Apps Script URL');
      const txt=await res.text();
      try{sheets=JSON.parse(txt);}catch(e){throw new Error('Apps Script did not return JSON (check the deployment is the latest version & access = Anyone)');}
      if(sheets.error)throw new Error(sheets.error);
    }else if(CFG.sheetId){
      let reached=0,failed=0;
      const fetches=DEPTS.map(async d=>{
        const u=`https://docs.google.com/spreadsheets/d/${CFG.sheetId}/gviz/tq?tqx=out:csv&sheet=${encodeURIComponent(d)}&${bust}`;
        try{const res=await fetch(u,{cache:'no-store'}); if(!res.ok){failed++;return;}
          const rows=parseCSV(await res.text()); if(rows.length<2)return;
          sheets[d]={headers:rows[0],rows:rows.slice(1).map((c,ix)=>({row:ix+2,cells:c}))}; reached++;
        }catch(e){failed++;}
      });
      await Promise.all(fetches);
      if(!reached)throw new Error('Could not read any tab — set sheet sharing to "Anyone with the link → Viewer", or use the Apps Script option');
    }else{setChip('Snapshot data','');return;}
    const recs=buildRecords(sheets);
    if(!recs.length)throw new Error('Connected, but parsed 0 rows — tab names may differ from the 10 expected departments');
    LIVE=recs; LAST_SYNC=new Date(); SYNC_ERR='';
    setChip('● Live · '+LAST_SYNC.toLocaleTimeString([],{hour:'2-digit',minute:'2-digit'})+' · '+recs.length+' PRs','live');
    document.getElementById('btnSync').style.display='';
    _dataKeyed=null;
    renderAll();
  }catch(e){
    SYNC_ERR=(e&&e.message)||'Fetch blocked by the browser (often CORS, or running inside a preview)';
    setChip('Sync failed — tap ⚙ to see why','err');
    document.getElementById('btnSync').style.display=CFG.appUrl||CFG.sheetId?'':'none';
    console.warn('Sync error:',e);
  }
}
function setChip(t,cls){const c=document.getElementById('syncChip');c.textContent=t;c.className='sync-chip '+(cls||'');}
async function pushUpdate(r,updates){ // write back to sheet via Apps Script
  if(!CFG.appUrl||!r._sheet||!r._row)return{ok:false,skip:true};
  try{
    const res=await fetch(CFG.appUrl,{method:'POST',body:JSON.stringify({action:'update',sheet:r._sheet,row:r._row,updates:updates})});
    return await res.json();
  }catch(e){return{ok:false,error:e.message};}
}
async function pushAppend(rec){
  if(!CFG.appUrl)return{ok:false,skip:true};
  try{
    const res=await fetch(CFG.appUrl,{method:'POST',body:JSON.stringify({action:'append',sheet:rec.dept,record:rec})});
    return await res.json();
  }catch(e){return{ok:false,error:e.message};}
}
/* config persistence: URL hash (works as local file) + window.storage (works in Claude) */
function cfgFromHash(){try{const h=location.hash.match(/cfg=([^&]+)/);if(h)CFG=JSON.parse(decodeURIComponent(h[1]));}catch(e){}}
function cfgToHash(){try{location.hash='cfg='+encodeURIComponent(JSON.stringify(CFG));}catch(e){}}
async function loadCfg(){
  cfgFromHash();
  try{if(window.storage&&!CFG.appUrl&&!CFG.sheetId){const r=await window.storage.get('oizom-pr-cfg');if(r&&r.value)CFG=JSON.parse(r.value);}}catch(e){}
  if(CFG.auto)setAutoRefresh(true);
}
async function saveCfg(){
  cfgToHash();
  try{if(window.storage)await window.storage.set('oizom-pr-cfg',JSON.stringify(CFG));}catch(e){}
}
/* ---------- persistence (overrides + added records) ---------- */
let OVR = {}, ADDED = [], VOVR = {}, VADDED = [];
async function loadStore(){
  try{
    if(!window.storage) return;
    try{const r=await window.storage.get('oizom-pr-ovr'); if(r&&r.value) OVR=JSON.parse(r.value);}catch(e){}
    try{const r=await window.storage.get('oizom-pr-added'); if(r&&r.value) ADDED=JSON.parse(r.value);}catch(e){}
    try{const r=await window.storage.get('oizom-vendor-ovr'); if(r&&r.value) VOVR=JSON.parse(r.value);}catch(e){}
    try{const r=await window.storage.get('oizom-vendor-added'); if(r&&r.value) VADDED=JSON.parse(r.value);}catch(e){}
  }catch(e){}
}
async function saveStore(){
  try{
    if(!window.storage) return;
    await window.storage.set('oizom-pr-ovr', JSON.stringify(OVR));
    await window.storage.set('oizom-pr-added', JSON.stringify(ADDED));
    await window.storage.set('oizom-vendor-ovr', JSON.stringify(VOVR));
    await window.storage.set('oizom-vendor-added', JSON.stringify(VADDED));
  }catch(e){}
}
let _dataKeyed=null;
function baseData(){
  if(LIVE)return LIVE;
  if(!_dataKeyed){const seen={};_dataKeyed=DATA.map(r=>{
    let ok=okeyOf(r); if(seen[ok]){seen[ok]++;ok+='#'+seen[ok];}else seen[ok]=1;
    return Object.assign({okey:ok},r);});}
  return _dataKeyed;
}
function rows(){
  const base=baseData().map(r=>OVR[r.okey]?Object.assign({},r,OVR[r.okey],{_edited:true}):r);
  return base.concat(ADDED.map(r=>Object.assign({_new:true},r)));
}

/* ---------- helpers ---------- */
const PAY_OPTS=['Paid','Unpaid','Partially Paid','FOC / Free'];
const MAT_OPTS=['In Process','In Transit','Received','Cancelled','On HOLD'];
const PRIO_OPTS=['High','Medium','Low'];
const CUR_SYM={INR:'₹',USD:'$',GBP:'£',EUR:'€',Euro:'€',JPY:'¥',CNY:'¥',AED:'د.إ ',SGD:'S$',AUD:'A$',CAD:'C$',CHF:'CHF ',Unknown:''};
const CUR_TOKENS=[['USD',['usd','us$','dollar','$']],['EUR',['euro','eur','€']],['GBP',['gbp','pound','£']],
 ['INR',['inr','rupee','rs.','rs ','₹']],['AED',['aed','dirham']],['SGD',['sgd']],
 ['JPY',['jpy','yen','¥']],['CNY',['cny','rmb','yuan']],['AUD',['aud']],['CAD',['cad']],['CHF',['chf']]];
function normCur(s){if(!s)return null;const t=String(s).trim().toLowerCase();
 for(const[code,toks]of CUR_TOKENS)for(const tok of toks)if(t.includes(tok))return code;
 if(/^[a-z]{3}$/.test(t))return t.toUpperCase(); return null;}
function detectCur(curCol,amtStr){
 let c=normCur(curCol); if(c)return{cur:c,auto:false};
 c=normCur(amtStr); if(c)return{cur:c,auto:true};
 if(amtStr&&/\d/.test(String(amtStr)))return{cur:'INR',auto:false,guess:true};
 return{cur:'Unknown',auto:false,guess:true};}
function parseAmtStr(s){ // returns {amt,note}
 if(s==null)return{};const t=String(s).trim();
 if(['','na','n/a','-','nan','tbd','--'].includes(t.toLowerCase()))return{};
 const m=t.match(/(\d[\d,]*(?:\.\d+)?)/); if(!m)return{note:t.slice(0,80)};
 const amt=Math.round(parseFloat(m[1].replace(/,/g,''))*100)/100;
 const clean=t.replace(/[\d,.\s₹$€£¥]+/g,'').toLowerCase();
 const note=clean&&!['inr','usd','rs','eur','euro','gbp','usd|pc'].includes(clean)?t.slice(0,80):undefined;
 return{amt:amt,note:note};}
const cSym=c=>CUR_SYM[c]!=null?CUR_SYM[c]:c+' ';
function fmtMoney(cur,n){
 const loc=cur==='INR'?'en-IN':'en-US';
 return cSym(cur)+Number(n).toLocaleString(loc,{maximumFractionDigits:2});}
function fmtCompact(cur,n){
 if(cur==='INR'){if(n>=1e7)return'₹'+(n/1e7).toFixed(2)+' Cr';if(n>=1e5)return'₹'+(n/1e5).toFixed(1)+'L';return'₹'+Math.round(n).toLocaleString('en-IN');}
 if(n>=1e6)return cSym(cur)+(n/1e6).toFixed(2)+'M';if(n>=1e3)return cSym(cur)+(n/1e3).toFixed(1)+'K';
 return cSym(cur)+Math.round(n).toLocaleString('en-US');}
function curTotals(list){ // {cur: sum} ordered by magnitude of count
 const t={};list.forEach(r=>{if(r.amt!=null&&typeof r.amt==='number')t[r.cur]=(t[r.cur]||0)+r.amt;});
 return Object.entries(t).sort((a,b)=>b[1]-a[1]);}
const fmtAmt=r=>r.amt==null||typeof r.amt!=='number'?'—':fmtMoney(r.cur,r.amt);
const esc=s=>s==null?'':String(s).replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));

/* ====== ACCESS CONTROL ======
   Paste generated user lines between the braces below to make logins permanent
   across devices/downloads. Leave empty to be prompted to create one on first run.
   Set AUTH_ENABLED=false to remove the login entirely. */
const AUTH_ENABLED = true;
const AUTH_SALT = 'oizom-proc-v1::';
const AUTH_USERS_FILE = {
  "admin": "c2f39758a16d03f1cd6df04a8f2edaea4464aa9c813505aab9507a9503aa91fa"
  /*__AUTH_USERS__*/
};
/* pure-JS SHA-256 so hashing is identical in every browser & offline (file://) */
function sha256(ascii){
  function rr(v,a){return (v>>>a)|(v<<(32-a));}
  const mp=Math.pow,maxW=mp(2,32);let result='',words=[],i,j;
  const bitLen=ascii.length*8;let hash=sha256.h=sha256.h||[];const k=sha256.k=sha256.k||[];
  let pc=k.length;const comp={};
  for(let cand=2;pc<64;cand++){if(!comp[cand]){for(i=0;i<313;i+=cand)comp[i]=cand;hash[pc]=(mp(cand,.5)*maxW)|0;k[pc++]=(mp(cand,1/3)*maxW)|0;}}
  ascii+='\x80';while(ascii.length%64-56)ascii+='\x00';
  for(i=0;i<ascii.length;i++){j=ascii.charCodeAt(i);if(j>>8)return;words[i>>2]|=j<<((3-i)%4)*8;}
  words[words.length]=(bitLen/maxW)|0;words[words.length]=bitLen;
  for(j=0;j<words.length;){
    const w=words.slice(j,j+=16);const oldHash=hash;hash=hash.slice(0,8);
    for(i=0;i<64;i++){
      const w15=w[i-15],w2=w[i-2];const a=hash[0],e=hash[4];
      const t1=hash[7]+(rr(e,6)^rr(e,11)^rr(e,25))+((e&hash[5])^((~e)&hash[6]))+k[i]+
        (w[i]=i<16?(w[i]|0):(w[i-16]+(rr(w15,7)^rr(w15,18)^(w15>>>3))+w[i-7]+(rr(w2,17)^rr(w2,19)^(w2>>>10)))|0);
      const t2=(rr(a,2)^rr(a,13)^rr(a,22))+((a&hash[1])^(a&hash[2])^(hash[1]&hash[2]));
      hash=[(t1+t2)|0].concat(hash);hash[4]=(hash[4]+t1)|0;
    }
    for(i=0;i<8;i++)hash[i]=(hash[i]+oldHash[i])|0;
  }
  for(i=0;i<8;i++)for(j=3;j+1;j--){const b=(hash[i]>>(j*8))&255;result+=((b<16)?0:'')+b.toString(16);}
  return result;
}
function hashPw(pw){return sha256(AUTH_SALT+unescape(encodeURIComponent(pw)));}
function authStore(get,val){
  try{
    if(get) return JSON.parse(localStorage.getItem('oizom-auth-users')||'{}');
    localStorage.setItem('oizom-auth-users',JSON.stringify(val));
  }catch(e){return {};}
}
function allUsers(){return Object.assign({},AUTH_USERS_FILE,authStore(true));}
let AUTHED=false, CURRENT_USER=null;
function authReveal(user){
  AUTHED=true; CURRENT_USER=user||CURRENT_USER;
  document.getElementById('authGate').classList.add('hidden');
  const lk=document.getElementById('btnLock'); if(lk)lk.style.display='';
  const uc=document.getElementById('userChip');
  if(uc&&CURRENT_USER){uc.style.display='';uc.innerHTML='Signed in as <b>'+esc(CURRENT_USER)+'</b>';}
}
function doLogout(){
  if(!confirm('Log out of the procurement tracker?'))return;
  AUTHED=false; CURRENT_USER=null;
  const uc=document.getElementById('userChip'); if(uc)uc.style.display='none';
  const lk=document.getElementById('btnLock'); if(lk)lk.style.display='none';
  if(typeof closeDrawer==='function')closeDrawer();
  document.getElementById('authGate').classList.remove('hidden');
  showLogin();
}
function showLogin(){
  const users=allUsers();
  const empty=Object.keys(users).length===0;
  const ab=document.getElementById('authBody');
  if(empty){ // first-run setup
    ab.innerHTML=`
      <h2>Create your login</h2>
      <p class="sub">No account exists yet. Set up the first user to protect this tool.</p>
      <label>Username</label><input id="suUser" autocomplete="username">
      <label>Password</label><input id="suPw" type="password" autocomplete="new-password">
      <label>Confirm password</label><input id="suPw2" type="password" autocomplete="new-password">
      <button class="auth-btn" id="suGo">Create &amp; enter</button>
      <div class="auth-err" id="suErr"></div>
      <div id="suDone"></div>`;
    ab.querySelector('#suGo').onclick=()=>{
      const u=ab.querySelector('#suUser').value.trim();
      const p=ab.querySelector('#suPw').value, p2=ab.querySelector('#suPw2').value;
      const err=ab.querySelector('#suErr');
      if(!u){err.textContent='Enter a username.';err.classList.add('show');return;}
      if(p.length<4){err.textContent='Password must be at least 4 characters.';err.classList.add('show');return;}
      if(p!==p2){err.textContent='Passwords do not match.';err.classList.add('show');return;}
      const h=hashPw(p);
      const cur=authStore(true); cur[u]=h; authStore(false,cur);
      err.classList.remove('show');
      ab.querySelector('#suDone').innerHTML=`<div class="auth-ok">Saved on this browser. To make this login permanent for everyone (survives re-downloads), paste this line inside <b>AUTH_USERS_FILE</b> in the file:<code>"${esc(u)}": "${h}",</code></div><button class="auth-btn" id="suEnter">Enter tool →</button>`;
      ab.querySelector('#suEnter').onclick=()=>authReveal(u);
    };
  }else{ // login
    ab.innerHTML=`
      <h2>Sign in</h2>
      <p class="sub">Enter your credentials to access the procurement tracker.</p>
      <label>Username</label><input id="liUser" autocomplete="username">
      <label>Password</label><input id="liPw" type="password" autocomplete="current-password">
      <button class="auth-btn" id="liGo">Sign in</button>
      <div class="auth-err" id="liErr">Incorrect username or password.</div>`;
    const go=()=>{
      const u=ab.querySelector('#liUser').value.trim();
      const p=ab.querySelector('#liPw').value;
      if(users[u]&&users[u]===hashPw(p)){authReveal(u);}
      else ab.querySelector('#liErr').classList.add('show');
    };
    ab.querySelector('#liGo').onclick=go;
    ab.querySelector('#liPw').addEventListener('keydown',e=>{if(e.key==='Enter')go();});
    ab.querySelector('#liUser').focus&&setTimeout(()=>ab.querySelector('#liUser').focus(),60);
  }
}
function initAuth(){
  if(!AUTH_ENABLED){document.getElementById('authGate').classList.add('hidden');return;}
  showLogin();
  const lk=document.getElementById('btnLock');
  if(lk)lk.onclick=doLogout;
}
/* fmtAmt defined above with multi-currency support */
function payCls(p){return p==='Paid'?'paid':p==='Unpaid'?'unpaid':p==='Partially Paid'?'part':p?'foc':'none';}
function matCls(m){return m==='Received'?'rcv':m==='In Transit'?'transit':m==='In Process'?'proc':m==='Cancelled'?'cancel':m==='On HOLD'?'hold':'none';}
function prioCls(p){return p==='High'?'hi':p==='Medium'?'med':p==='Low'?'lo':'none';}
function stage(r){ if(r.mat==='Cancelled')return -1;
  if(r.mat==='Received')return 4; if(r.mat==='In Transit'||r.trackNo)return 3;
  if(r.poNo||r.invNo)return 2; return 1; }
const STAGES=['Requested','PO / Order','Dispatched','Received'];
function pipeHTML(r,big){
  const s=stage(r), cancel=s===-1, eff=cancel?1:s;
  if(big){
    let h='<div class="bigpipe">';
    STAGES.forEach((nm,i)=>{ if(i>0)h+=`<div class="cc ${i<eff?'on':''}"></div>`;
      h+=`<div class="st"><div class="d ${i<eff?'on':''}"></div><span>${nm}</span></div>`;});
    return h+'</div>'+(cancel?'<div class="pipelbl" style="color:var(--red)">Cancelled</div>':'');
  }
  let h=`<div class="pipe ${cancel?'cancel':''}">`;
  for(let i=0;i<4;i++){ if(i>0)h+=`<div class="c ${i<eff?'on':''}"></div>`; h+=`<div class="d ${i<eff?'on':''}"></div>`;}
  h+='</div><div class="pipelbl">'+(cancel?'Cancelled':STAGES[Math.max(eff-1,0)])+'</div>';
  return h;
}

/* ---------- state ---------- */
let F={q:'',dept:'',pay:'',mat:'',prio:'',type:'',cur:'',vendor:'',dFrom:'',dTo:'',kpi:''};
let SORT={key:'ts',dir:-1};
let VIEW='table', DASH_METRIC='count', DASH_CUR='';

function passesFilters(r,ignoreDate){
  if(F.dept&&r.dept!==F.dept)return false;
  if(F.pay&&(r.pay||'')!==F.pay)return false;
  if(F.mat&&(r.mat||'')!==F.mat)return false;
  if(F.prio&&(r.prio||'')!==F.prio)return false;
  if(F.type&&(r.matType||'')!==F.type)return false;
  if(F.cur&&r.cur!==F.cur)return false;
  if(F.vendor&&vcanon(r.vendor)!==F.vendor)return false;
  if(!ignoreDate){
    if(F.dFrom&&(!r.ts||r.ts<F.dFrom))return false;
    if(F.dTo&&(!r.ts||r.ts>F.dTo))return false;
  }
  if(F.kpi==='unpaid'&&r.pay!=='Unpaid')return false;
  if(F.kpi==='open'&&!(r.mat==='In Process'||r.mat==='In Transit'||r.mat==='On HOLD'||!r.mat))return false;
  if(F.kpi==='transit'&&r.mat!=='In Transit')return false;
  if(F.q){
    const hay=[r.id,r.desc,r.vendor,r.poNo,r.invNo,r.trackNo,r.reqBy,r.part,r.dept,r.proj].join(' ').toLowerCase();
    if(!hay.includes(F.q.toLowerCase()))return false;
  }
  return true;
}
function sortRows(out){
  const k=SORT.key,d=SORT.dir;
  return out.sort((a,b)=>{
    let x=a[k],y=b[k];
    if(k==='amt'){x=x==null?-1:x;y=y==null?-1:y;return (x-y)*d;}
    if(k==='stage'){return (stage(a)-stage(b))*d;}
    x=(x||'').toString().toLowerCase();y=(y||'').toString().toLowerCase();
    return x<y?-d:x>y?d:0;
  });
}
function filtered(){return sortRows(rows().filter(r=>passesFilters(r,false)));}
function rowsForMonth(k){return sortRows(rows().filter(r=>passesFilters(r,true)&&monthKey(r.ts)===k));}

/* ---------- KPIs ---------- */
function renderKPIs(){
  const all=rows();
  const unpaid=all.filter(r=>r.pay==='Unpaid');
  const upT=curTotals(unpaid);
  const open=all.filter(r=>r.mat==='In Process'||r.mat==='In Transit'||r.mat==='On HOLD'||!r.mat);
  const transit=all.filter(r=>r.mat==='In Transit');
  const rcv=all.filter(r=>r.mat==='Received').length;
  const spT=curTotals(all.filter(r=>r.mat!=='Cancelled'));
  const joinT=t=>t.length?t.map(([c,n])=>fmtCompact(c,n)).join(' + '):'—';
  const k=[
    {id:'',n:all.length,l:'Total PRs',s:[...new Set(all.map(r=>r.cur))].sort().join(' · ')},
    {id:'unpaid',n:unpaid.length,l:'Unpaid',s:joinT(upT),cls:'bad'},
    {id:'open',n:open.length,l:'Open dispatch',s:'in process / transit / hold',cls:'warn'},
    {id:'transit',n:transit.length,l:'In transit',s:'trackable shipments',cls:'warn'},
    {id:'',n:Math.round(rcv/(all.length||1)*100)+'%',l:'Received',s:rcv+' of '+all.length,cls:'go',static:1},
    {id:'',n:spT.length?fmtCompact(spT[0][0],spT[0][1]):'—',l:'Total spend',s:spT.length>1?'+ '+joinT(spT.slice(1)):'all in '+(spT[0]?spT[0][0]:'—'),static:1},
  ];
  document.getElementById('kpis').innerHTML=k.map(x=>
    `<div class="kpi ${x.cls||''} ${F.kpi===x.id&&x.id?'active':''}" data-k="${x.id}" ${x.static?'style="cursor:default"':''}>
      <div class="n">${x.n}</div><div class="l">${x.l}</div><div class="s">${x.s}</div></div>`).join('');
  document.querySelectorAll('.kpi[data-k]').forEach(el=>{
    const id=el.dataset.k; if(!id)return;
    el.onclick=()=>{F.kpi=F.kpi===id?'':id;renderAll();};
  });
}

/* ---------- table ---------- */
const COLS=[
  {k:'id',t:'PR'},{k:'ts',t:'Date'},{k:'dept',t:'Dept'},{k:'desc',t:'Item / Vendor'},
  {k:'amt',t:'Amount'},{k:'prio',t:'Priority'},{k:'pay',t:'Payment'},
  {k:'stage',t:'Dispatch pipeline'},{k:'mat',t:'Status'}
];
function renderHead(){
  document.getElementById('thead').innerHTML=COLS.map(c=>
    `<th data-k="${c.k}">${c.t}${SORT.key===c.k?`<span class="arr">${SORT.dir>0?'▲':'▼'}</span>`:''}</th>`).join('');
  document.querySelectorAll('th').forEach(th=>th.onclick=()=>{
    const k=th.dataset.k;
    if(SORT.key===k)SORT.dir*=-1;else{SORT.key=k;SORT.dir=k==='ts'?-1:1;}
    renderAll();
  });
}
function renderTable(){
  const list=filtered();
  document.getElementById('count').textContent=list.length+' of '+rows().length+' PRs';
  document.getElementById('empty').style.display=list.length?'none':'block';
  renderCtxBanner(list);
  document.getElementById('tbody').innerHTML=list.map(r=>`
    <tr data-id="${esc(r.id)}">
      <td class="prid">${esc(r.id)}${r._new?'<span class="tagnew">NEW</span>':''}${r._edited?'<span class="tagedit">EDITED</span>':''}</td>
      <td class="dt">${esc(r.ts||'—')}</td>
      <td>${esc(r.dept)}</td>
      <td class="desc">${esc(r.desc||'—')}<div class="v">${esc(r.vendor||'')}${r.qty?' · qty '+esc(r.qty):''}</div></td>
      <td class="amt" title="${esc(r.amtNote||'')}${r.curGuess?' (currency assumed)':''}">${fmtAmt(r)}${r.amt!=null?'<div class="curcode">'+esc(r.cur)+(r.curAuto?'·auto':r.curGuess?'·?':'')+'</div>':(r.amtNote?'<div class="curcode">'+esc(r.amtNote.slice(0,18))+'</div>':'')}</td>
      <td><span class="b ${prioCls(r.prio)}">${esc(r.prio||'—')}</span></td>
      <td><span class="b ${payCls(r.pay)}">${esc(r.pay||'—')}</span></td>
      <td>${pipeHTML(r)}</td>
      <td><span class="b ${matCls(r.mat)}">${esc(r.mat||'—')}</span></td>
    </tr>`).join('');
  document.querySelectorAll('tbody tr').forEach(tr=>tr.onclick=()=>openDrawer(tr.dataset.id));
}
function renderAll(){renderKPIs();renderHead();renderTable();if(VIEW==='dash')renderDash();if(VIEW==='vendor')renderVendors();}

function renderCtxBanner(list){
  const el=document.getElementById('ctxBanner');
  if(!F.dFrom&&!F.dTo){el.style.display='none';return;}
  // label: single month if range == one calendar month, else from–to
  let label;
  const single=F.dFrom&&F.dTo&&F.dFrom.slice(0,7)===F.dTo.slice(0,7)&&F.dFrom.slice(8)==='01';
  if(single){label=monthLabel(F.dFrom.slice(0,7));}
  else label=(F.dFrom||'start')+'  →  '+(F.dTo||'now');
  const sp=curTotals(list);
  const join=t=>t.length?t.map(([c,n])=>fmtMoney(c,n)).join(' · '):'—';
  el.style.display='flex';
  el.innerHTML=`<b>${esc(label)}</b>
    <span class="meta">${list.length} PRs · spend ${join(sp)}</span>
    <span class="acts">
      <button id="bnkDash">← Back to dashboard</button>
      <button id="bnkClear">Clear date filter</button>
    </span>`;
  el.querySelector('#bnkDash').onclick=()=>{switchView('dash');renderAll();window.scrollTo({top:0,behavior:'smooth'});};
  el.querySelector('#bnkClear').onclick=()=>{
    F.dFrom='';F.dTo='';
    document.getElementById('dFrom').value='';document.getElementById('dTo').value='';
    document.getElementById('dQuick').value='';renderAll();
  };
}

/* ---------- monthly dashboard ---------- */
const MON=['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'];
function monthKey(ts){return ts&&/^\d{4}-\d{2}/.test(ts)?ts.slice(0,7):null;}
function monthLabel(k){const[y,m]=k.split('-');return MON[+m-1]+" '"+y.slice(2);}
function monthData(list){
  const M={};let undated=0;
  list.forEach(r=>{
    const k=monthKey(r.ts); if(!k){undated++;return;}
    if(!M[k])M[k]={count:0,spend:{},unpaid:0,unpaidV:{},rcv:0};
    const m=M[k]; m.count++;
    if(r.pay==='Unpaid')m.unpaid++;
    if(r.mat==='Received')m.rcv++;
    if(r.amt!=null&&typeof r.amt==='number'){
      m.spend[r.cur]=(m.spend[r.cur]||0)+r.amt;
      if(r.pay==='Unpaid')m.unpaidV[r.cur]=(m.unpaidV[r.cur]||0)+r.amt;
    }
  });
  return {months:M,keys:Object.keys(M).sort(),undated};
}
function allCurrencies(list){return [...new Set(list.filter(r=>r.amt!=null).map(r=>r.cur))].sort();}

function renderDash(){
  const list=filtered();
  const {months,keys,undated}=monthData(list);
  const curs=allCurrencies(list);
  // currency selector visibility (only for spend/unpaid metrics)
  const needCur=DASH_METRIC!=='count'&&curs.length>0;
  document.getElementById('dashCurWrap').style.display=needCur?'flex':'none';
  if(needCur){
    const sel=document.getElementById('dashCur');
    if(!DASH_CUR||!curs.includes(DASH_CUR))DASH_CUR=curs[0];
    sel.innerHTML=curs.map(c=>`<option ${c===DASH_CUR?'selected':''}>${c}</option>`).join('');
    sel.onchange=e=>{DASH_CUR=e.target.value;renderDash();};
  }
  // metric value per month
  function mv(k){const m=months[k];
    if(DASH_METRIC==='count')return m.count;
    if(DASH_METRIC==='spend')return m.spend[DASH_CUR]||0;
    return m.unpaidV[DASH_CUR]||0;}
  const isMoney=DASH_METRIC!=='count';
  const unit=isMoney?DASH_CUR:'';
  document.getElementById('dashTitle').textContent=
    DASH_METRIC==='count'?'PR count per month':
    DASH_METRIC==='spend'?'Spend per month · '+DASH_CUR:'Unpaid value per month · '+DASH_CUR;
  // chart
  document.getElementById('chart').innerHTML=barChart(keys,keys.map(mv),isMoney,unit);
  bindBars(keys);
  // summary
  renderDashSummary(list,months,keys,mv,isMoney,unit,undated);
  // table
  renderMonthTable(months,keys,curs);
  // keep an open month detail panel in sync
  if(OPEN_MONTH&&keys.includes(OPEN_MONTH))renderMonthDetail(OPEN_MONTH);
  else if(OPEN_MONTH){OPEN_MONTH=null;document.getElementById('monthDetail').style.display='none';}
}

function barChart(keys,vals,isMoney,unit){
  if(!keys.length)return '<div class="empty" style="padding:40px"><b>No dated requests in range</b>Adjust the date filter.</div>';
  const n=keys.length, bw=Math.max(38,Math.min(70,720/n));
  const W=Math.max(620,n*bw+60), H=240, pad={t:24,b:34,l:46,r:10};
  const max=Math.max(...vals,1);
  const niceMax=max<=5?5:Math.ceil(max/Math.pow(10,Math.floor(Math.log10(max))))*Math.pow(10,Math.floor(Math.log10(max)));
  const plotH=H-pad.t-pad.b, plotW=W-pad.l-pad.r;
  const x=i=>pad.l+(plotW/n)*(i+.5);
  const y=v=>pad.t+plotH*(1-v/niceMax);
  let g='';
  for(let t=0;t<=4;t++){const gv=niceMax*t/4, gy=y(gv);
    g+=`<line class="gridline" x1="${pad.l}" y1="${gy}" x2="${W-pad.r}" y2="${gy}"/>`;
    g+=`<text class="axis-lbl" x="${pad.l-6}" y="${gy+3}" text-anchor="end">${isMoney?fmtCompact(unit,gv):Math.round(gv)}</text>`;}
  let bars='';
  keys.forEach((k,i)=>{
    const v=vals[i], by=y(v), bh=pad.t+plotH-by, cx=x(i), w=Math.min(bw-14,40);
    bars+=`<rect class="bar-rect" data-k="${k}" x="${cx-w/2}" y="${by}" width="${w}" height="${Math.max(bh,1)}" rx="4" fill="var(--brand)"><title>${monthLabel(k)}: ${isMoney?fmtMoney(unit,v):v+' PRs'}</title></rect>`;
    if(v>0)bars+=`<text class="bar-val" x="${cx}" y="${by-5}" text-anchor="middle">${isMoney?fmtCompact(unit,v):v}</text>`;
    bars+=`<text class="bar-lbl" x="${cx}" y="${H-pad.b+15}" text-anchor="middle">${monthLabel(k)}</text>`;
  });
  return `<svg viewBox="0 0 ${W} ${H}" width="${W}" height="${H}" xmlns="http://www.w3.org/2000/svg">${g}${bars}</svg>`;
}
function switchView(v){
  VIEW=v;
  document.querySelectorAll('.vtab').forEach(x=>x.classList.toggle('active',x.dataset.v===v));
  document.getElementById('tableView').style.display=v==='table'?'':'none';
  document.getElementById('dashView').style.display=v==='dash'?'':'none';
  document.getElementById('vendorView').style.display=v==='vendor'?'':'none';
}
let OPEN_MONTH=null;
function showMonthPRs(k){
  OPEN_MONTH=k;
  renderMonthDetail(k);
  const el=document.getElementById('monthDetail');
  el.scrollIntoView({behavior:'smooth',block:'start'});
}
function renderMonthDetail(k){
  const el=document.getElementById('monthDetail');
  if(!k){el.style.display='none';return;}
  const list=rowsForMonth(k);
  const sp=curTotals(list);
  const join=t=>t.length?t.map(([c,n])=>fmtMoney(c,n)).join(' · '):'—';
  el.style.display='';
  el.innerHTML=`
    <div class="cardhead">
      <h3>PRs in ${monthLabel(k)} <span style="color:var(--mut);font-weight:400">(${list.length})</span></h3>
      <div class="acts" style="margin-left:auto;display:flex;gap:8px">
        <button class="mini-btn" id="mdFull">Open in full table ↗</button>
        <button class="mini-btn" id="mdClose">✕ Close</button>
      </div>
    </div>
    <div class="md-meta">Spend ${join(sp)} · ${list.filter(r=>r.pay==='Unpaid').length} unpaid · ${list.filter(r=>r.mat==='Received').length} received</div>
    <div class="mtablewrap"><table class="md-table">
      <thead><tr><th>PR</th><th>Date</th><th>Dept</th><th>Item / Vendor</th><th>Amount</th><th>Payment</th><th>Status</th></tr></thead>
      <tbody>${list.map(r=>`
        <tr data-id="${esc(r.id)}">
          <td class="prid">${esc(r.id)}</td>
          <td class="dt">${esc(r.ts||'—')}</td>
          <td>${esc(r.dept)}</td>
          <td class="desc">${esc(r.desc||'—')}<div class="v">${esc(r.vendor||'')}</div></td>
          <td class="amt">${fmtAmt(r)}</td>
          <td><span class="b ${payCls(r.pay)}">${esc(r.pay||'—')}</span></td>
          <td><span class="b ${matCls(r.mat)}">${esc(r.mat||'—')}</span></td>
        </tr>`).join('')||'<tr><td colspan="7" style="text-align:center;color:var(--mut);padding:24px">No PRs match the current filters in this month.</td></tr>'}</tbody>
    </table></div>`;
  el.querySelectorAll('tbody tr[data-id]').forEach(tr=>tr.onclick=()=>openDrawer(tr.dataset.id));
  el.querySelector('#mdClose').onclick=()=>{OPEN_MONTH=null;el.style.display='none';};
  el.querySelector('#mdFull').onclick=()=>gotoMonth(k);
}
function gotoMonth(k){
  const [y,m]=k.split('-'); const last=new Date(+y,+m,0).getDate();
  F.dFrom=k+'-01'; F.dTo=k+'-'+String(last).padStart(2,'0');
  document.getElementById('dFrom').value=F.dFrom;
  document.getElementById('dTo').value=F.dTo;
  document.getElementById('dQuick').value='';
  switchView('table'); renderAll();
  window.scrollTo({top:0,behavior:'smooth'});
}
function bindBars(keys){
  document.querySelectorAll('.bar-rect').forEach(b=>b.onclick=()=>showMonthPRs(b.dataset.k));
}

function renderDashSummary(list,months,keys,mv,isMoney,unit,undated){
  const totalPR=list.length;
  const spendTot=curTotals(list);
  const unpaidTot=curTotals(list.filter(r=>r.pay==='Unpaid'));
  const avg=keys.length?Math.round(totalPR/keys.length):0;
  // peak month by current metric
  let peakK=null,peakV=-1; keys.forEach(k=>{const v=mv(k);if(v>peakV){peakV=v;peakK=k;}});
  const join=t=>t.length?t.map(([c,n])=>fmtCompact(c,n)).join(' · '):'—';
  document.getElementById('dashSummary').innerHTML=`
    <div class="cardhead"><h3>In selected range</h3></div>
    <div class="sumrow"><span class="lab">Total PRs</span><span class="val">${totalPR}</span></div>
    <div class="sumrow"><span class="lab">Months covered</span><span class="val">${keys.length}</span></div>
    <div class="sumrow"><span class="lab">Avg PRs / month</span><span class="val">${avg}</span></div>
    <div class="sumrow"><span class="lab">Total spend</span><span class="val mono">${join(spendTot)}</span></div>
    <div class="sumrow"><span class="lab">Unpaid value</span><span class="val mono" style="color:var(--red)">${join(unpaidTot)}</span></div>
    ${undated?`<div class="sumrow"><span class="lab">Undated PRs</span><span class="val mono">${undated}</span></div>`:''}
    ${peakK?`<div class="peak"><div class="pk-l">Peak month · ${DASH_METRIC==='count'?'PRs':DASH_METRIC==='spend'?'spend':'unpaid'}</div><div class="pk-v">${monthLabel(peakK)} — ${isMoney?fmtMoney(unit,peakV):peakV+' PRs'}</div></div>`:''}`;
}

function renderMonthTable(months,keys,curs){
  const primary=curs[0]||'INR';
  const maxCount=Math.max(...keys.map(k=>months[k].count),1);
  let head=`<thead><tr><th>Month</th><th>PRs</th>`+
    curs.map(c=>`<th>${c} spend</th>`).join('')+
    `<th>Unpaid</th><th>Received</th></tr></thead>`;
  let body='<tbody>'+keys.slice().reverse().map(k=>{
    const m=months[k];
    const sp=curs.map(c=>`<td>${m.spend[c]?fmtMoney(c,m.spend[c]):'—'}</td>`).join('');
    const w=Math.round(m.count/maxCount*60);
    return `<tr data-k="${k}"><td>${monthLabel(k)}<span class="minibar" style="width:${w}px"></span></td>`+
      `<td>${m.count}</td>${sp}<td>${m.unpaid||'—'}</td><td>${Math.round(m.rcv/m.count*100)}%</td></tr>`;
  }).join('')+'</tbody>';
  // totals
  const tot={};curs.forEach(c=>tot[c]=keys.reduce((s,k)=>s+(months[k].spend[c]||0),0));
  const totPR=keys.reduce((s,k)=>s+months[k].count,0);
  const totUn=keys.reduce((s,k)=>s+months[k].unpaid,0);
  const totRcv=keys.reduce((s,k)=>s+months[k].rcv,0);
  let foot=`<tfoot><tr><td>Total</td><td>${totPR}</td>`+
    curs.map(c=>`<td>${tot[c]?fmtMoney(c,tot[c]):'—'}</td>`).join('')+
    `<td>${totUn||'—'}</td><td>${totPR?Math.round(totRcv/totPR*100):0}%</td></tr></tfoot>`;
  document.getElementById('mtable').innerHTML=head+body+foot;
  document.querySelectorAll('.mtable tbody tr').forEach(tr=>tr.onclick=()=>showMonthPRs(tr.dataset.k));
}

/* ---------- drawer ---------- */
const overlay=document.getElementById('overlay'),drawer=document.getElementById('drawer');
function closeDrawer(){overlay.classList.remove('open');drawer.classList.remove('open');}
overlay.onclick=closeDrawer;
document.addEventListener('keydown',e=>{if(e.key==='Escape')closeDrawer();});

function kvRow(k,v,mono,link){
  if(v==null||v==='')return'';
  const val=link?`<a href="${esc(v)}" target="_blank" rel="noopener">${esc(v.length>60?v.slice(0,60)+'…':v)}</a>`:esc(v);
  return `<div class="k">${k}</div><div class="v ${mono?'mono':''}">${val}</div>`;
}
function openDrawer(id){
  const r=rows().find(x=>x.id===id); if(!r)return;
  drawer.innerHTML=`
   <div class="dr-head">
     <div><span class="prid">${esc(r.id)} · ${esc(r.dept)}</span><h2>${esc(r.desc||'Purchase request')}</h2></div>
     <button class="dr-close" aria-label="Close">✕</button>
   </div>
   <div class="dr-body">
     <div class="dr-sec"><h3>Lifecycle</h3>${pipeHTML(r,true)}</div>
     <div class="dr-sec"><h3>Update status</h3>
       <div class="dr-edit">
         <div><label>Payment status</label><select id="ePay">${['',...PAY_OPTS].map(o=>`<option ${o===(r.pay||'')?'selected':''}>${o}</option>`).join('')}</select></div>
         <div><label>Dispatch / material status</label><select id="eMat">${['',...MAT_OPTS].map(o=>`<option ${o===(r.mat||'')?'selected':''}>${o}</option>`).join('')}</select></div>
         <div><label>PO number</label><input id="ePo" value="${esc(r.poNo||'')}"></div>
         <div><label>Tracking number</label><input id="eTrk" value="${esc(r.trackNo||'')}"></div>
         <div><label>Courier / FF</label><input id="eCr" value="${esc(r.courier||'')}"></div>
         <div><label>Material received date</label><input id="eRcv" type="date" value="${esc(r.rcvDate&&/^\\d{4}-\\d{2}-\\d{2}$/.test(r.rcvDate)?r.rcvDate:'')}"></div>
         <div class="full"><label>Remarks</label><textarea id="eRem">${esc(r.remarks||'')}</textarea></div>
       </div>
     </div>
     <div class="dr-sec"><h3>Request</h3><div class="kv">
       ${kvRow('Requested by',r.reqBy)}${kvRow('Approved by',r.appBy)}${kvRow('Date',r.ts,1)}
       ${kvRow('Project',r.proj)}${kvRow('Zoho part no.',r.part,1)}${kvRow('Material type',r.matType)}
       ${kvRow('Quantity',r.qty,1)}${kvRow('Amount',fmtAmt(r),1)}${kvRow('Currency',r.cur+(r.curAuto?' (auto-detected from amount)':''))}${kvRow('Amount note',r.amtNote)}${kvRow('Priority',r.prio)}
       ${kvRow('Comment',r.comment)}
     </div></div>
     <div class="dr-sec"><h3>Vendor &amp; order</h3><div class="kv">
       ${kvRow('Vendor',r.vendor)}${kvRow('Purchase link',r.link,1,r.link&&r.link.startsWith('http'))}
       ${kvRow('PO no.',r.poNo,1)}${kvRow('PO date',r.poDate,1)}
       ${kvRow('Invoice / order no.',r.invNo,1)}${kvRow('Invoice date',r.invDate,1)}
       ${kvRow('Payment term',r.payTerm)}${kvRow('Due date',r.dueDate,1)}
     </div></div>
     <div class="dr-sec"><h3>Dispatch</h3><div class="kv">
       ${kvRow('Courier / FF',r.courier)}${kvRow('Tracking no.',r.trackNo,1)}
       ${kvRow('Tracking link',r.trackLink,1,r.trackLink&&r.trackLink.startsWith('http'))}
       ${kvRow('Received on',r.rcvDate,1)}${kvRow('Remarks',r.remarks)}
     </div></div>
   </div>
   <div class="dr-foot">
     <button class="btn primary" id="eSave">Save changes</button>
     <button class="btn" id="eCancel">Close</button>
     <span class="saved" id="savedMsg">Saved ✓</span>
   </div>`;
  drawer.querySelector('.dr-close').onclick=closeDrawer;
  drawer.querySelector('#eCancel').onclick=closeDrawer;
  drawer.querySelector('#eSave').onclick=async()=>{
    const g=i=>drawer.querySelector(i).value.trim();
    const patch={pay:g('#ePay')||undefined,mat:g('#eMat')||undefined,poNo:g('#ePo')||undefined,trackNo:g('#eTrk')||undefined,courier:g('#eCr')||undefined,rcvDate:g('#eRcv')||undefined,remarks:g('#eRem')||undefined};
    if(r._new){const i=ADDED.findIndex(x=>x.id===r.id);if(i>-1)Object.assign(ADDED[i],patch);}
    else OVR[r.okey]=Object.assign({},OVR[r.okey]||{},patch);
    await saveStore();
    const m=drawer.querySelector('#savedMsg');
    m.textContent='Saved locally ✓'; m.classList.add('show');
    const push=await pushUpdate(r,patch);
    if(push.ok){m.textContent='Saved to sheet ✓'; const br=baseData().find(x=>x.okey===r.okey); if(br)Object.assign(br,patch); delete OVR[r.okey]; await saveStore();}
    else if(!push.skip){m.textContent='Saved locally — sheet write failed'; m.style.color='var(--amber)';}
    setTimeout(()=>{m.classList.remove('show');m.style.color='';},2200);
    renderAll(); openDrawer(id);
  };
  overlay.classList.add('open');drawer.classList.add('open');
}

/* ---------- new PR ---------- */
document.getElementById('btnNew').onclick=()=>{
  const depts=[...new Set(rows().map(r=>r.dept))].sort();
  drawer.innerHTML=`
   <div class="dr-head"><div><h2>New purchase request</h2></div><button class="dr-close">✕</button></div>
   <div class="dr-body"><div class="dr-sec"><div class="dr-edit">
     <div><label>Department</label><select id="nDept">${depts.map(d=>`<option>${d}</option>`).join('')}</select></div>
     <div><label>Requested by</label><input id="nReq"></div>
     <div class="full"><label>Product description *</label><input id="nDesc"></div>
     <div><label>Vendor</label><input id="nVen"></div>
     <div><label>Quantity</label><input id="nQty"></div>
     <div><label>Currency</label><select id="nCur"><option>INR</option><option>USD</option><option>EUR</option><option>GBP</option><option>AED</option><option>SGD</option><option>JPY</option><option>CNY</option><option>AUD</option><option>CAD</option><option>CHF</option><option>Unknown</option></select></div>
     <div><label>Amount</label><input id="nAmt" type="number" step="0.01"></div>
     <div><label>Priority</label><select id="nPrio">${PRIO_OPTS.map(p=>`<option>${p}</option>`).join('')}</select></div>
     <div><label>Payment status</label><select id="nPay">${PAY_OPTS.map(p=>`<option ${p==='Unpaid'?'selected':''}>${p}</option>`).join('')}</select></div>
     <div><label>Material type</label><input id="nType" placeholder="Inventory / Asset / Local Purchase…"></div>
     <div><label>Project</label><input id="nProj"></div>
     <div class="full"><label>Comment</label><textarea id="nCom"></textarea></div>
   </div></div></div>
   <div class="dr-foot"><button class="btn primary" id="nSave">Create PR</button><button class="btn" id="nCancel">Cancel</button></div>`;
  drawer.querySelector('.dr-close').onclick=closeDrawer;
  drawer.querySelector('#nCancel').onclick=closeDrawer;
  drawer.querySelector('#nSave').onclick=async()=>{
    const g=i=>drawer.querySelector(i).value.trim();
    if(!g('#nDesc')){drawer.querySelector('#nDesc').focus();return;}
    const maxN=rows().reduce((m,r)=>Math.max(m,parseInt(r.id.replace('PR-',''))||0),0);
    const rec={id:'PR-'+String(maxN+1).padStart(4,'0'),dept:g('#nDept'),ts:new Date().toISOString().slice(0,10),
      reqBy:g('#nReq')||undefined,desc:g('#nDesc'),vendor:g('#nVen')||undefined,qty:g('#nQty')||undefined,
      cur:g('#nCur'),amt:g('#nAmt')?parseFloat(g('#nAmt')):undefined,prio:g('#nPrio'),pay:g('#nPay'),
      mat:'In Process',matType:g('#nType')||undefined,proj:g('#nProj')||undefined,comment:g('#nCom')||undefined};
    ADDED.push(rec); await saveStore();
    const push=await pushAppend(rec);
    if(push.ok){ADDED.pop(); await saveStore(); await syncNow();}
    closeDrawer(); renderAll();
  };
  overlay.classList.add('open');drawer.classList.add('open');
};

/* ---------- export ---------- */
document.getElementById('btnExport').onclick=()=>{
  const cols=['id','ts','dept','reqBy','appBy','proj','part','desc','matType','vendor','qty','cur','amt','amtNote','prio','pay','payTerm','dueDate','poNo','poDate','invNo','invDate','courier','trackNo','trackLink','mat','rcvDate','remarks','comment'];
  const head=['PR ID','Date','Department','Requested By','Approved By','Project','Zoho Part','Description','Material Type','Vendor','Qty','Currency','Amount','Amount Note','Priority','Payment Status','Payment Term','Due Date','PO No','PO Date','Invoice/Order No','Invoice Date','Courier','Tracking No','Tracking Link','Material Status','Received Date','Remarks','Comment'];
  const csv=[head.join(',')].concat(filtered().map(r=>cols.map(c=>{
    let v=r[c]==null?'':String(r[c]); return '"'+v.replace(/"/g,'""')+'"';
  }).join(','))).join('\n');
  const a=document.createElement('a');
  a.href=URL.createObjectURL(new Blob([csv],{type:'text/csv'}));
  a.download='oizom_procurement_export.csv'; a.click();
};

/* ---------- filters ---------- */
function fillSelect(id,vals){
  const el=document.getElementById(id);
  vals.forEach(v=>{const o=document.createElement('option');o.textContent=v;o.value=v;el.appendChild(o);});
}
function initFilters(){
  const all=rows();
  fillSelect('fDept',[...new Set(all.map(r=>r.dept))].sort());
  fillSelect('fPay',PAY_OPTS);
  fillSelect('fMat',MAT_OPTS);
  fillSelect('fPrio',PRIO_OPTS);
  fillSelect('fType',[...new Set(all.map(r=>r.matType).filter(Boolean))].sort());
  fillSelect('fCur',[...new Set(all.map(r=>r.cur).filter(Boolean))].sort());
  // vendor dropdown uses merged (canonical) vendors
  buildCanon();
  const vmap={};
  all.forEach(r=>{if(!r.vendor)return;const k=vcanon(r.vendor);if(!k)return;
    if(!vmap[k])vmap[k]=VNAME[k]||r.vendor;});
  const vsel=document.getElementById('fVendor');
  Object.entries(vmap).sort((a,b)=>a[1].localeCompare(b[1])).forEach(([k,name])=>{
    const o=document.createElement('option');o.value=k;o.textContent=name;vsel.appendChild(o);});
  document.getElementById('q').oninput=e=>{F.q=e.target.value;renderTable();renderHead();};
  [['fDept','dept'],['fPay','pay'],['fMat','mat'],['fPrio','prio'],['fType','type'],['fCur','cur'],['fVendor','vendor']].forEach(([id,k])=>{
    document.getElementById(id).onchange=e=>{F[k]=e.target.value;renderAll();};
  });
  // date range
  document.getElementById('dFrom').onchange=e=>{F.dFrom=e.target.value;document.getElementById('dQuick').value='';renderAll();};
  document.getElementById('dTo').onchange=e=>{F.dTo=e.target.value;document.getElementById('dQuick').value='';renderAll();};
  document.getElementById('dQuick').onchange=e=>applyQuickRange(e.target.value);
  // view tabs
  document.querySelectorAll('.vtab').forEach(t=>t.onclick=()=>{switchView(t.dataset.v);renderAll();});
  // metric buttons
  document.querySelectorAll('.mbtn').forEach(b=>b.onclick=()=>{
    DASH_METRIC=b.dataset.m;
    document.querySelectorAll('.mbtn').forEach(x=>x.classList.toggle('active',x===b));
    renderDash();
  });
  document.getElementById('btnClr').onclick=()=>{
    F={q:'',dept:'',pay:'',mat:'',prio:'',type:'',cur:'',vendor:'',dFrom:'',dTo:'',kpi:''};
    document.getElementById('q').value='';
    ['fDept','fPay','fMat','fPrio','fType','fCur','fVendor','dFrom','dTo','dQuick'].forEach(i=>document.getElementById(i).value='');
    renderAll();
  };
}
function applyQuickRange(v){
  const now=new Date(),y=now.getFullYear(),m=now.getMonth();
  const iso=d=>d.toISOString().slice(0,10);
  let from='',to='';
  if(v==='thismonth'){from=iso(new Date(y,m,1));to=iso(new Date(y,m+1,0));}
  else if(v==='lastmonth'){from=iso(new Date(y,m-1,1));to=iso(new Date(y,m,0));}
  else if(v==='last3'){from=iso(new Date(y,m-2,1));to=iso(new Date(y,m+1,0));}
  else if(v==='last6'){from=iso(new Date(y,m-5,1));to=iso(new Date(y,m+1,0));}
  else if(v==='thisyear'){from=y+'-01-01';to=y+'-12-31';}
  F.dFrom=from;F.dTo=to;
  document.getElementById('dFrom').value=from;document.getElementById('dTo').value=to;
  renderAll();
}

/* ---------- connect sheet ---------- */
document.getElementById('btnSync').onclick=()=>syncNow();
document.getElementById('btnConnect').onclick=()=>{
  drawer.innerHTML=`
   <div class="dr-head"><div><h2>Connect Google Sheet</h2></div><button class="dr-close">✕</button></div>
   <div class="dr-body">
     <div class="dr-sec">
       <h3>Option A — Apps Script (recommended: read + write back)</h3>
       <p style="font-size:12.5px;color:var(--mut);line-height:1.55;margin-bottom:10px">
         Deploy the <b>Code.gs</b> script (provided with this tool) on your sheet as a Web App,
         then paste its URL here. Status updates and new PRs will save directly into the sheet.</p>
       <div class="dr-edit"><div class="full"><label>Web App URL</label>
         <input id="cUrl" placeholder="https://script.google.com/macros/s/…/exec" value="${esc(CFG.appUrl||'')}"></div></div>
     </div>
     <div class="dr-sec">
       <h3>Option B — Sheet ID only (read-only live data)</h3>
       <p style="font-size:12.5px;color:var(--mut);line-height:1.55;margin-bottom:10px">
         Set the sheet's sharing to <b>Anyone with the link → Viewer</b>, then paste the spreadsheet ID
         (the long code in the sheet URL between <span style="font-family:var(--mono)">/d/</span> and
         <span style="font-family:var(--mono)">/edit</span>).</p>
       <div class="dr-edit"><div class="full"><label>Spreadsheet ID</label>
         <input id="cId" placeholder="1AbC…xyz" value="${esc(CFG.sheetId||'')}"></div></div>
     </div>
     <div class="dr-sec">
       <label class="vchk" style="font-size:13px"><input type="checkbox" id="cAuto" ${AUTO_REFRESH?'checked':''}> Auto-refresh every 60 seconds while open</label>
       <p style="font-size:12px;color:var(--mut);line-height:1.55;margin-top:10px">
        Tip: each sync now bypasses the browser cache, so the <b>↻ Sync</b> button in the header always pulls the newest sheet data. If totals still look old, click ↻ Sync once more.<br>
        Live sync needs the browser to reach Google directly. Inside the Claude preview, external requests are blocked, so it falls back to the built-in snapshot — download the file and open it in Chrome/Edge for live mode.
        ${SYNC_ERR?'<br><br><b style="color:var(--red)">Last sync error:</b><br><span style="color:var(--red)">'+esc(SYNC_ERR)+'</span>':''}</p>
     </div>
   </div>
   <div class="dr-foot">
     <button class="btn primary" id="cSave">Save &amp; sync</button>
     <button class="btn" id="cResync">↻ Force resync</button>
     <button class="btn" id="cOff">Disconnect</button>
   </div>`;
  drawer.querySelector('.dr-close').onclick=closeDrawer;
  drawer.querySelector('#cAuto').onchange=e=>{setAutoRefresh(e.target.checked);saveCfg();};
  drawer.querySelector('#cResync').onclick=()=>{syncNow();};
  drawer.querySelector('#cOff').onclick=async()=>{CFG={appUrl:'',sheetId:''};LIVE=null;await saveCfg();setChip('Snapshot data','');document.getElementById('btnSync').style.display='none';closeDrawer();renderAll();};
  drawer.querySelector('#cSave').onclick=async()=>{
    CFG.appUrl=drawer.querySelector('#cUrl').value.trim();
    let id=drawer.querySelector('#cId').value.trim();
    const m=id.match(/\/d\/([a-zA-Z0-9_-]+)/); if(m)id=m[1];
    CFG.sheetId=id;
    await saveCfg(); closeDrawer(); await syncNow();
  };
  overlay.classList.add('open');drawer.classList.add('open');
};

/* ---------- vendors ---------- */
let VF={q:'',type:'',bank:false,sort:'prCount'};
// strip legal suffixes, domains, punctuation, common filler so variants collapse to one key
const VENDOR_STOP=/\b(co|ltd|pvt|private|limited|llp|inc|corp|corporation|company|gmbh|technologies|technology|tech|electronics|electronic|enterprise|enterprises|industries|industry|industrial|solutions|international|in|com|the)\b/g;
function vnorm(s){
  let t=(s||'').toLowerCase().trim();
  t=t.replace(/https?:\/\/(www\.)?/g,'').replace(/\.(com|in|net|org|co)\b/g,' ');
  t=t.replace(/[^a-z0-9 ]/g,' ').replace(VENDOR_STOP,' ');
  t=t.replace(/\s+/g,'');
  return t||((s||'').toLowerCase().replace(/[^a-z0-9]/g,''));
}
function classifyType(spend){
  const c=Object.keys(spend||{});
  if(!c.length)return 'Unknown';
  const foreign=c.some(x=>['USD','EUR','GBP','CNY','JPY','AED','SGD','AUD','CAD','CHF'].includes(x));
  if(foreign&&!c.includes('INR'))return 'Foreign';
  if(c.length===1&&c[0]==='INR')return 'Domestic';
  return c.length>1?'Mixed':'Unknown';
}
/* canonical merge: collapses domain/suffix variants AND prefix variants
   (e.g. "Cubic" + "Cubic Sensor and Instrument Co Ltd" -> one vendor). */
let VCANON={}, VNAME={};
function buildCanon(){
  const names=new Set();
  VENDORS.forEach(v=>names.add(v.name));
  VADDED.forEach(v=>names.add(v.name));
  rows().forEach(r=>{if(r.vendor)names.add(r.vendor);});
  const counts={}, longest={};
  [...names].forEach(n=>{const k=vnorm(n);if(!k)return;counts[k]=(counts[k]||0)+1;
    if(!longest[k]||n.length>longest[k].length)longest[k]=n;});
  const keys=Object.keys(counts).sort((a,b)=>a.length-b.length);
  const map={};
  keys.forEach(k=>{
    let canon=k;
    for(const c of keys){ // shortest prefix (>=5 chars) becomes canonical
      if(c!==k&&c.length>=5&&c.length<k.length&&k.startsWith(c)){canon=map[c]||c;break;}
    }
    map[k]=canon;
  });
  // pick a friendly display name per canonical key: the most-seen, then longest
  const disp={};
  keys.forEach(k=>{const c=map[k];
    if(!disp[c]||counts[k]>disp[c].cnt||(counts[k]===disp[c].cnt&&longest[k].length>disp[c].name.length))
      disp[c]={name:longest[k],cnt:counts[k]};});
  VCANON=map; VNAME={}; Object.keys(disp).forEach(c=>VNAME[c]=disp[c].name);
}
function vcanon(name){const k=vnorm(name);return VCANON[k]||k;}

function vendorList(){
  buildCanon();
  const B={}; // canonical bucket
  const get=k=>B[k]||(B[k]={norm:k,name:VNAME[k]||k,prCount:0,spend:{},depts:new Set(),
    unpaid:0,rcv:0,last:null,_variants:new Set()});
  // master enrichment (bank/terms/contact) from snapshot + added
  const applyMaster=(v,isNew)=>{
    const k=vcanon(v.name); const b=get(k); b._variants.add(v.name);
    ['bank','acct','ifsc','swift','contact','email','phone','address','gst','category','notes','rating'].forEach(f=>{if(v[f]&&!b[f])b[f]=v[f];});
    if(v.terms&&v.terms.length&&!(b.terms&&b.terms.length))b.terms=v.terms;
    if(v.trackingOnly)b.trackingOnly=1;
    if(isNew)b._new=1;
    if(v.spend)Object.entries(v.spend).forEach(([c,n])=>{if(!B[k]._hasLive)b.spend[c]=(b.spend[c]||0)+n;});
  };
  VENDORS.forEach(v=>applyMaster(v,false));
  VADDED.forEach(v=>applyMaster(v,true));
  // live PR-derived stats (authoritative for spend/counts)
  rows().forEach(pr=>{
    if(!pr.vendor)return; const k=vcanon(pr.vendor); if(!k)return;
    const b=get(k); b._variants.add(pr.vendor);
    if(!b._hasLive){b._hasLive=1;b.spend={};} // live spend overrides any master spend
    b.prCount++;
    if(pr.dept)b.depts.add(pr.dept);
    if(pr.amt!=null&&typeof pr.amt==='number')b.spend[pr.cur]=(b.spend[pr.cur]||0)+pr.amt;
    if(pr.pay==='Unpaid')b.unpaid++;
    if(pr.mat==='Received')b.rcv++;
    if(pr.ts&&(!b.last||pr.ts>b.last))b.last=pr.ts;
  });
  const out=Object.values(B).map(b=>{
    b.depts=[...b.depts].sort();
    b.variantCount=b._variants.size; delete b._variants; delete b._hasLive;
    b.type=classifyType(b.spend);
    if(VOVR[b.norm]){Object.assign(b,VOVR[b.norm]);b._edited=1;}
    return b;
  });
  return out;
}
function vfiltered(){
  let out=vendorList().filter(v=>{
    if(VF.q&&!(v.name||'').toLowerCase().includes(VF.q.toLowerCase()))return false;
    if(VF.type&&v.type!==VF.type)return false;
    if(VF.bank&&!v.bank)return false;
    return true;
  });
  const s=VF.sort;
  out.sort((a,b)=>{
    if(s==='name')return (a.name||'').localeCompare(b.name||'');
    if(s==='spend'){const av=Object.values(a.spend||{}).reduce((x,y)=>x+y,0),bv=Object.values(b.spend||{}).reduce((x,y)=>x+y,0);return bv-av;}
    if(s==='unpaid')return (b.unpaid||0)-(a.unpaid||0);
    return (b.prCount||0)-(a.prCount||0);
  });
  return out;
}
function rowsForVendor(k){return sortRows(rows().filter(r=>vcanon(r.vendor)===k));}

function renderVendors(){
  const list=vfiltered();
  document.getElementById('vcount').textContent=list.length+' vendors';
  document.getElementById('vempty').style.display=list.length?'none':'block';
  const join=sp=>{const e=Object.entries(sp||{});return e.length?e.map(([c,n])=>fmtCompact(c,n)).join(' · '):'—';};
  document.getElementById('vgrid').innerHTML=list.map(v=>`
    <div class="vcard" data-k="${esc(v.norm)}">
      <div class="vhead">
        <h4>${esc(v.name||'(unnamed)')} ${v._new?'<span class="vnewt">NEW</span>':''}${v._edited?'<span class="vedited">EDITED</span>':''}</h4>
        <span class="vtype ${v.type}">${v.type}</span>
      </div>
      <div class="vstats">
        <div class="vstat"><div class="n">${v.prCount||0}</div><div class="l">Purchase reqs</div></div>
        <div class="vstat"><div class="n" style="font-size:14px">${join(v.spend)}</div><div class="l">Total spend</div></div>
        <div class="vstat"><div class="n ${v.unpaid?'red':''}">${v.unpaid||0}</div><div class="l">Unpaid</div></div>
        <div class="vstat"><div class="n" style="font-size:12px;color:var(--mut);font-family:var(--mono)">${esc(v.last||'—')}</div><div class="l">Last order</div></div>
      </div>
      <div class="vmeta">
        ${v.bank?'<span class="tag"><span class="vbankdot"></span>'+esc(v.bank.slice(0,22))+'</span>':''}
        ${(v.depts||[]).slice(0,3).map(d=>'<span class="tag">'+esc(d)+'</span>').join('')}
        ${v.category?'<span class="tag">'+esc(v.category)+'</span>':''}
        ${v.variantCount>1?'<span class="tag" style="color:var(--blue)">merged '+v.variantCount+' names</span>':''}
        ${v.trackingOnly&&!v.prCount?'<span class="tag" style="color:var(--mut)">payment records only</span>':''}
      </div>
    </div>`).join('');
  document.querySelectorAll('.vcard').forEach(c=>c.onclick=()=>openVendor(c.dataset.k));
}

function openVendor(k){
  const v=vendorList().find(x=>x.norm===k); if(!v)return;
  const prs=rowsForVendor(k);
  const join=sp=>Object.entries(sp||{});
  drawer.innerHTML=`
   <div class="dr-head"><div>
     <span class="prid">${esc(v.type)} vendor${v.trackingOnly&&!v.prCount?' · payment records only':''}</span>
     <h2>${esc(v.name||'(unnamed)')}</h2>
   </div><button class="dr-close">✕</button></div>
   <div class="dr-body">
     <div class="dr-sec"><h3>Activity</h3>
       <div class="vp-spend">
         <div class="s"><div class="v">${v.prCount||0}</div><div class="l">Purchase requests</div></div>
         ${join(v.spend).map(([c,n])=>`<div class="s"><div class="v">${fmtMoney(c,n)}</div><div class="l">${c} spend</div></div>`).join('')}
         <div class="s"><div class="v" style="color:${v.unpaid?'var(--red)':'inherit'}">${v.unpaid||0}</div><div class="l">Unpaid</div></div>
       </div>
       ${v.depts&&v.depts.length?`<div class="vmeta" style="border:none;padding:0;margin-top:8px">${v.depts.map(d=>'<span class="tag">'+esc(d)+'</span>').join('')}</div>`:''}
     </div>
     <div class="dr-sec"><h3>Vendor details <span style="font-weight:400;color:var(--mut);text-transform:none;letter-spacing:0">(editable)</span></h3>
       <div class="dr-edit">
         <div class="full"><label>Vendor name</label><input id="vName" value="${esc(v.name||'')}"></div>
         <div><label>Category</label><input id="vCat" value="${esc(v.category||'')}" placeholder="Sensors, PCB, Packaging…"></div>
         <div><label>Type</label><select id="vTyp">${['Domestic','Foreign','Mixed','Unknown'].map(o=>`<option ${o===v.type?'selected':''}>${o}</option>`).join('')}</select></div>
         <div><label>Contact person</label><input id="vCon" value="${esc(v.contact||'')}"></div>
         <div><label>Phone</label><input id="vPh" value="${esc(v.phone||'')}"></div>
         <div class="full"><label>Email</label><input id="vEm" value="${esc(v.email||'')}"></div>
         <div class="full"><label>Address</label><input id="vAddr" value="${esc(v.address||'')}"></div>
         <div><label>GST / Tax ID</label><input id="vGst" value="${esc(v.gst||'')}"></div>
         <div><label>Rating (1–5)</label><input id="vRate" type="number" min="1" max="5" value="${esc(v.rating||'')}"></div>
       </div>
     </div>
     <div class="dr-sec"><h3>Banking &amp; payment</h3>
       <div class="dr-edit">
         <div class="full"><label>Bank name</label><input id="vBk" value="${esc(v.bank||'')}"></div>
         <div><label>Account number</label><input id="vAc" value="${esc(v.acct||'')}"></div>
         <div><label>IFSC</label><input id="vIf" value="${esc(v.ifsc||'')}"></div>
         <div><label>SWIFT</label><input id="vSw" value="${esc(v.swift||'')}"></div>
         <div class="full"><label>Payment terms</label><input id="vTm" value="${esc((v.terms||[]).join(', '))}"></div>
         <div class="full"><label>Notes</label><textarea id="vNt">${esc(v.notes||'')}</textarea></div>
       </div>
     </div>
     <div class="dr-sec"><h3>Purchase requests (${prs.length})</h3>
       <div class="vp-prlist">${prs.length?prs.map(r=>`
         <div class="vp-pr" data-id="${esc(r.id)}">
           <span class="pid">${esc(r.id)}</span>
           <span class="pd">${esc((r.desc||'—').slice(0,42))}<div style="font-size:11px;color:var(--mut)">${esc(r.ts||'')} · ${esc(r.dept||'')}</div></span>
           <span class="b ${payCls(r.pay)}" style="flex:none">${esc(r.pay||'—')}</span>
           <span class="pa">${fmtAmt(r)}</span>
         </div>`).join(''):'<div style="color:var(--mut);padding:12px 0">No purchase requests linked yet.</div>'}</div>
     </div>
   </div>
   <div class="dr-foot">
     <button class="btn primary" id="vSave">Save vendor</button>
     <button class="btn" id="vCancel">Close</button>
     <span class="saved" id="vSaved">Saved ✓</span>
   </div>`;
  drawer.querySelector('.dr-close').onclick=closeDrawer;
  drawer.querySelector('#vCancel').onclick=closeDrawer;
  drawer.querySelectorAll('.vp-pr[data-id]').forEach(el=>el.onclick=()=>openDrawer(el.dataset.id));
  drawer.querySelector('#vSave').onclick=async()=>{
    const g=i=>drawer.querySelector(i).value.trim();
    const patch={name:g('#vName')||v.name,category:g('#vCat')||undefined,type:g('#vTyp'),
      contact:g('#vCon')||undefined,phone:g('#vPh')||undefined,email:g('#vEm')||undefined,
      address:g('#vAddr')||undefined,gst:g('#vGst')||undefined,rating:g('#vRate')||undefined,
      bank:g('#vBk')||undefined,acct:g('#vAc')||undefined,ifsc:g('#vIf')||undefined,swift:g('#vSw')||undefined,
      terms:g('#vTm')?g('#vTm').split(',').map(s=>s.trim()).filter(Boolean):undefined,
      notes:g('#vNt')||undefined};
    Object.keys(patch).forEach(x=>{if(patch[x]===undefined)delete patch[x];});
    VOVR[k]=Object.assign({},VOVR[k]||{},patch);
    await saveStore();
    const m=drawer.querySelector('#vSaved');m.classList.add('show');setTimeout(()=>m.classList.remove('show'),1600);
    renderVendors();
  };
  overlay.classList.add('open');drawer.classList.add('open');
}

document.getElementById('btnAddVendor').onclick=()=>{
  drawer.innerHTML=`
   <div class="dr-head"><div><h2>Add vendor</h2></div><button class="dr-close">✕</button></div>
   <div class="dr-body"><div class="dr-sec"><div class="dr-edit">
     <div class="full"><label>Vendor name *</label><input id="aName"></div>
     <div><label>Category</label><input id="aCat" placeholder="Sensors, PCB…"></div>
     <div><label>Type</label><select id="aTyp"><option>Domestic</option><option>Foreign</option><option>Mixed</option><option>Unknown</option></select></div>
     <div><label>Contact person</label><input id="aCon"></div>
     <div><label>Phone</label><input id="aPh"></div>
     <div class="full"><label>Email</label><input id="aEm"></div>
     <div class="full"><label>Address</label><input id="aAddr"></div>
     <div><label>GST / Tax ID</label><input id="aGst"></div>
     <div class="full"><label>Bank name</label><input id="aBk"></div>
     <div><label>Account number</label><input id="aAc"></div>
     <div><label>IFSC</label><input id="aIf"></div>
     <div><label>SWIFT</label><input id="aSw"></div>
     <div class="full"><label>Payment terms</label><input id="aTm" placeholder="100% advance"></div>
     <div class="full"><label>Notes</label><textarea id="aNt"></textarea></div>
   </div></div></div>
   <div class="dr-foot"><button class="btn primary" id="aSave">Add vendor</button><button class="btn" id="aCancel">Cancel</button></div>`;
  drawer.querySelector('.dr-close').onclick=closeDrawer;
  drawer.querySelector('#aCancel').onclick=closeDrawer;
  drawer.querySelector('#aSave').onclick=async()=>{
    const g=i=>drawer.querySelector(i).value.trim();
    if(!g('#aName')){drawer.querySelector('#aName').focus();return;}
    const k=vnorm(g('#aName'));
    const rec={name:g('#aName'),norm:k,category:g('#aCat')||undefined,type:g('#aTyp'),
      contact:g('#aCon')||undefined,phone:g('#aPh')||undefined,email:g('#aEm')||undefined,
      address:g('#aAddr')||undefined,gst:g('#aGst')||undefined,bank:g('#aBk')||undefined,
      acct:g('#aAc')||undefined,ifsc:g('#aIf')||undefined,swift:g('#aSw')||undefined,
      terms:g('#aTm')?[g('#aTm')]:undefined,notes:g('#aNt')||undefined,spend:{}};
    Object.keys(rec).forEach(x=>{if(rec[x]===undefined)delete rec[x];});
    const i=VADDED.findIndex(x=>(x.norm||vnorm(x.name))===k);
    if(i>-1)VADDED[i]=rec;else VADDED.push(rec);
    await saveStore(); closeDrawer(); renderVendors();
  };
  overlay.classList.add('open');drawer.classList.add('open');
};
// vendor filter wiring
document.getElementById('vq').oninput=e=>{VF.q=e.target.value;renderVendors();};
document.getElementById('vType').onchange=e=>{VF.type=e.target.value;renderVendors();};
document.getElementById('vSort').onchange=e=>{VF.sort=e.target.value;renderVendors();};
document.getElementById('vBank').onchange=e=>{VF.bank=e.target.checked;renderVendors();};

(async function(){ initAuth(); await loadStore(); await loadCfg(); initFilters(); renderAll(); if(CFG.appUrl||CFG.sheetId)syncNow(); })();
</script>
</body>
</html>